  "layoutEvidence": {
    "scope": "Frozen original-client HUD layout rules. Displayed empty cells do not establish a Core gameplay capacity limit.",
    "tactics": {
      "renderer": "iGt.UpdateZhanfaItem",
      "countSource": "The owned tactic item IDs returned for the current run; the renderer reverses that list before placing cells.",
      "rowsPerColumn": 3,
      "slotFormula": "ownedCount > 0 ? 3 * (ceil(ownedCount / 3) + (ownedCount <= 12 ? 1 : 0)) : 0",
      "fillOrder": "Top to bottom within each column, columns from right to left. Remaining displayed cells use zhanfa_slot_bg.",
      "panelHeight": 108,
      "panelWidthFormula": "37 * (displayedSlotCount / 3)",
      "examples": [
        {
          "owned": 8,
          "columns": 4,
          "slots": 12,
          "empty": 4
        },
        {
          "owned": 10,
          "columns": 5,
          "slots": 15,
          "empty": 5
        },
        {
          "owned": 13,
          "columns": 5,
          "slots": 15,
          "empty": 2
        },
        {
          "owned": 16,
          "columns": 6,
          "slots": 18,
          "empty": 2
        }
      ],
      "capacityConclusion": "The source renderer has no fixed fifteen-tactic limit; the number of columns grows with the owned count."
    },
    "skills": {
      "renderer": "iGt.UpdateSkillItem -> b0i.SetSkill",
      "rowsPerColumn": 3,
      "logicalCellSize": [
        117,
        39
      ],
      "fillOrder": "Base skills first, then acquired extra skills, then unlocked empty cells and locked cells. The first column is beside the hero, with later columns extending leftward.",
      "positionFormula": "x = -117 * (floor(index / 3) + 1); y = 39 * (index % 3)",
      "validContentSlotCount": "baseSkillCount + configuredExtraSlotCount; the source does not add cells merely to fill the final column.",
      "frozenSourceConfiguration": {
        "table": "hd_roguelike.Common[0]",
        "spellmax": 3,
        "spellnum": 2,
        "meaning": "Three configured extra skill slots, two initially unlocked. Acquired extra skills occupy these slots; run, tactic and profile bonuses can change the unlocked count.",
        "missingConfigurationFallback": 4
      },
      "emptyState": "A missing skill uses roguesmall_skill_null while remaining unlocked extra slots are positive, otherwise roguesmall_skill_lock. The second b0i.SetSkill parameter is true for locked cells."
    },
    "hero": {
      "renderer": "iGt.UpdateGameData -> Pzt.General_GradationChanged -> Kas.SetGrade",
      "runRankSource": "The larger of profileStar minus one and the matching GeneralPool.trail_star value, overridden by the special egg-general rank when supplied.",
