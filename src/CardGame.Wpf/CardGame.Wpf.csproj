<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CardGame.Wpf</AssemblyName>
    <RootNamespace>CardGame.Wpf</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Characters\**\Wpf\**\*.cs">
      <Link>Characters\$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)\..\Characters', '%(FullPath)'))</Link>
    </Compile>
    <EmbeddedResource Include="Assets\Data\shanhe-codex-2026.json" LogicalName="CardGame.ShanheCodex2026.json" />
    <!-- Binary assets have an independent lifecycle from the application assembly. -->
    <Content Include="Assets\**\*.png;Assets\**\*.jpg;Assets\**\*.mp3;Assets\**\*.wav"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="..\..\docs\content\table-art-catalog.json" LogicalName="CardGame.TableArtCatalog.json" />
    <EmbeddedResource Include="..\..\docs\content\card-art-catalog.json" LogicalName="CardGame.CardArtCatalog.json" />
    <EmbeddedResource Include="..\..\docs\content\general-art-catalog.json" LogicalName="CardGame.GeneralArtCatalog.json" />
    <EmbeddedResource Include="..\..\docs\content\game-audio-catalog.json" LogicalName="CardGame.GameAudioCatalog.json" />
    <ProjectReference Include="..\CardGame.Core\CardGame.Core.csproj" />
    <ProjectReference Include="..\CardGame.Lan\CardGame.Lan.csproj" />
    <ProjectReference Include="..\CardGame.Content.Standard\CardGame.Content.Standard.csproj" />
  </ItemGroup>
</Project>
