<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="ShanheRewardConfirmButton" TargetType="Button">
  <Setter Property="Foreground" Value="#FFF0C9"/><Setter Property="FontFamily" Value="KaiTi"/><Setter Property="FontSize" Value="25"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Width" Value="175"/><Setter Property="Height" Value="57"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Grid x:Name="ButtonFace" Background="Transparent">
    <Image Source="pack://siteoforigin:,,,/Assets/Shanhe/rog_ok_normal.png" Stretch="Fill" IsHitTestVisible="False"/>
    <Border x:Name="FocusOutline" BorderBrush="#FFF0B5" BorderThickness="1" Margin="4" Visibility="Collapsed" IsHitTestVisible="False"/>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="Visibility" Value="Visible"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.75"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonFace" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="ShanheRewardChoiceButton" TargetType="Button">
  <Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <!-- The unfocusable description scroller keeps body clicks on the card while its own track and wheel remain interactive. -->
   <Grid Background="{TemplateBinding Background}"><ContentPresenter x:Name="ChoiceFace" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/></Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceFace" Property="Effect"><Setter.Value><DropShadowEffect Color="#F8C959" BlurRadius="15" ShadowDepth="0" Opacity="0.5"/></Setter.Value></Setter></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ChoiceFace" Property="Opacity" Value="0.5"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
