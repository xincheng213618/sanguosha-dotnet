<UserControl x:Class="CardGame.Wpf.Controls.ShanhePlayerHud"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="240" Height="330" AutomationProperties.Name="本次山河图武将与行装">
 <UserControl.Resources>
  <DataTemplate x:Key="BuildBadge">
   <Border Background="#E83A482B" BorderBrush="#9DB17A" BorderThickness="1" Padding="8,5" Margin="0,0,5,5" MinWidth="75">
    <Border.ToolTip><ToolTip MaxWidth="420"><TextBlock Text="{Binding RuleTooltip}" TextWrapping="Wrap" LineHeight="22"/></ToolTip></Border.ToolTip>
    <TextBlock Text="{Binding Name}" Foreground="#E0EDB9" TextAlignment="Center" FontSize="12"/>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="98"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{Binding CurrentShanheGeneralPortrait}" BorderBrush="#C5A45F" BorderThickness="2" Margin="0,0,9,6"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,0,6"><TextBlock Text="{Binding CurrentShanheGeneralName}" Foreground="#EFF2C5" FontFamily="KaiTi" FontSize="22" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ShanheVitalText}" Foreground="#DBEDAB" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/><TextBlock Text="{Binding ShanheGoldText}" Foreground="#E5C477" FontSize="13" Margin="0,6,0,0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="#D92C281D" BorderBrush="#927646" BorderThickness="1" Padding="10,9">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><TextBlock Text="{Binding ShanheRankStatusText}" Foreground="#E5D399" FontSize="11"/><TextBlock Text="{Binding ShanheSkillsText}" Foreground="#B8B396" FontSize="10" TextWrapping="Wrap" Margin="8,0,0,0" MaxHeight="30"/></DockPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,9,0,5">
     <StackPanel>
      <TextBlock Text="{Binding CurrentShanheGeneralSkillsText}" Foreground="#DBE9B8" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" ToolTip="自带技能"/>
      <ItemsControl x:Name="ShanheStartingCompanionRows" ItemsSource="{Binding ShanheStartingCompanionCards}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="#97A274" BorderThickness="1" Padding="5" Margin="0,0,0,5"><Border.ToolTip><ToolTip MaxWidth="420"><TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="21"/></ToolTip></Border.ToolTip>
        <StackPanel Orientation="Horizontal"><Border Width="28" Height="35" Background="{Binding Portrait}" Margin="0,0,7,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="开局队友" Foreground="#A9A58A" FontSize="10"/><TextBlock Text="{Binding Name}" Foreground="#D7E1A7" FontSize="12"/></StackPanel></StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl x:Name="ShanheRecruitedCompanionRows" ItemsSource="{Binding ShanheRecruitedCompanionCards}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="#7E9060" BorderThickness="1" Padding="5" Margin="0,0,0,5"><Border.ToolTip><ToolTip MaxWidth="420"><TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="21"/></ToolTip></Border.ToolTip>
        <StackPanel Orientation="Horizontal"><Border Width="28" Height="35" Background="{Binding Portrait}" Margin="0,0,7,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="奇遇队友" Foreground="#A9A58A" FontSize="10"/><TextBlock Text="{Binding Name}" Foreground="#D7E1A7" FontSize="12"/></StackPanel></StackPanel>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <ItemsControl ItemsSource="{Binding ShanheExtraSkillCards}" ItemTemplate="{StaticResource BuildBadge}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
      <ItemsControl ItemsSource="{Binding ShanheTacticCards}" ItemTemplate="{StaticResource BuildBadge}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
     </StackPanel>
    </ScrollViewer>
   </Grid>
  </Border>
 </Grid>
</UserControl>
