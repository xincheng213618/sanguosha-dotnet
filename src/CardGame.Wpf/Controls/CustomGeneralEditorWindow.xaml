<Window x:Class="CardGame.Wpf.Controls.CustomGeneralEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义武将 · 本地武将库" Width="1380" Height="880" MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterOwner" Background="#151B23" Foreground="#F1E7D4">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1E7D4" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="11,7" /><Setter Property="Margin" Value="3" /><Setter Property="Background" Value="#D4B576" /><Setter Property="Foreground" Value="#181C23" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6" /><Setter Property="Background" Value="#101722" /><Setter Property="Foreground" Value="#F5EDDE" /><Setter Property="BorderBrush" Value="#566170" /><Setter Property="CaretBrush" Value="#FFF2D1" /></Style>
        <Style TargetType="ComboBox">
            <Style.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#17212B" /></Style></Style.Resources>
            <Setter Property="Padding" Value="6,5" /><Setter Property="MinHeight" Value="31" /><Setter Property="MaxDropDownHeight" Value="240" /><Setter Property="Foreground" Value="#17212B" />
        </Style>
        <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#17212B" /><Setter Property="Background" Value="#F2F2F2" /></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F1E7D4" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#222C38" /><Setter Property="BorderBrush" Value="#3F4C5E" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Padding" Value="13" /></Style>
        <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,11" /></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#B9C6D5" /><Setter Property="Margin" Value="0,7,0,4" /></Style>
        <Style TargetType="ListBox"><Setter Property="Background" Value="#151E2B" /><Setter Property="BorderBrush" Value="#475264" /><Setter Property="Foreground" Value="#F1E7D4" /><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" /></Style>
        <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="7" /></Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <StackPanel><TextBlock Text="自定义武将" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="组合已有技能，或用时机、目标与效果设计新技能。" Foreground="#BBC8D7" Margin="0,5,0,0" /></StackPanel>
            <TextBlock Text="本地武将库 · 下一新局生效" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#D4B576" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="215" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.05*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="我的武将库" Style="{StaticResource Heading}" />
                    <WrapPanel Grid.Row="1" Margin="-3,0,-3,8"><Button x:Name="NewGeneralButton" Content="新建" Command="{Binding NewCommand}" /><Button Content="复制" Command="{Binding DuplicateCommand}" /><Button Content="删除" Command="{Binding DeleteCommand}" /></WrapPanel>
                    <ListBox x:Name="GeneralLibraryList" Grid.Row="2" ItemsSource="{Binding Generals}" SelectedItem="{Binding SelectedGeneral, Mode=TwoWay}" AutomationProperties.Name="本地武将列表">
                        <ListBox.ItemTemplate><DataTemplate><DockPanel><CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="7,0,0,0" ToolTip="是否加入下一局可选武将" /><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="15" /><TextBlock Text="{Binding EnabledText}" FontSize="11" Foreground="#97A7BA" Margin="0,3,0,0" /></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="3" Text="勾选启用后可在新局选将中选择。删除、停用和其他修改都需保存。" FontSize="12" Foreground="#A8B5C5" Margin="0,10,0,0" />
                </Grid>
            </Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel IsEnabled="{Binding HasSelection}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,11">
                        <StackPanel><TextBlock Text="基础属性" Style="{StaticResource Heading}" />
                            <Grid DataContext="{Binding SelectedGeneral}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="姓名" Style="{StaticResource Label}" /><TextBox x:Name="GeneralNameText" Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" AutomationProperties.Name="武将姓名" />
                                <TextBlock Grid.Row="2" Text="势力" Style="{StaticResource Label}" /><TextBlock Grid.Row="2" Grid.Column="2" Text="性别" Style="{StaticResource Label}" />
                                <ComboBox x:Name="GeneralFactionCombo" Grid.Row="3" ItemsSource="{Binding DataContext.FactionChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding FactionId, Mode=TwoWay}" />
                                <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding DataContext.GenderChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Gender, Mode=TwoWay}" />
                                <TextBlock Grid.Row="4" Text="体力上限" Style="{StaticResource Label}" /><CheckBox Grid.Row="4" Grid.Column="2" Content="指定初始体力" IsChecked="{Binding UseInitialHp}" Margin="0,7,0,4" />
                                <ComboBox Grid.Row="5" ItemsSource="{Binding DataContext.HpValues, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding BaseHp, Mode=TwoWay}" />
                                <ComboBox Grid.Row="5" Grid.Column="2" ItemsSource="{Binding DataContext.HpValues, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding InitialHp, Mode=TwoWay}" IsEnabled="{Binding UseInitialHp}" />
                            </Grid>
                            <TextBlock Text="立绘 · 选择已有武将的形象" Style="{StaticResource Label}" />
                            <ComboBox ItemsSource="{Binding PortraitChoices}" DisplayMemberPath="Name" SelectedValuePath="Key" SelectedValue="{Binding SelectedGeneral.PortraitKey, Mode=TwoWay}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="已有技能" Style="{StaticResource Heading}" /><TextBlock Grid.Row="1" Text="{Binding SelectedSkillCountText}" Foreground="#D4B576" Margin="0,0,0,8" />
                        <TextBox x:Name="ExistingSkillSearchText" Grid.Row="2" Text="{Binding SkillSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="按技能名或规则文字搜索" AutomationProperties.Name="搜索已有技能" Margin="0,0,0,8" />
                        <ListBox x:Name="ExistingSkillList" Grid.Row="3" ItemsSource="{Binding ExistingSkillChoices}" Height="225" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" Tag="{Binding Id}" ToolTip="{Binding Description}" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="#ABBBCD" FontSize="11" MaxHeight="50" Margin="0,4,0,0" /></StackPanel></CheckBox></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid></Border>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="1.4*" MinHeight="250" /><RowDefinition Height="11" /><RowDefinition Height="*" MinHeight="105" /></Grid.RowDefinitions>
                <Border Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <DockPanel><TextBlock Text="自捏技能" Style="{StaticResource Heading}" /><WrapPanel HorizontalAlignment="Right"><Button x:Name="AddCustomSkillButton" Content="添加技能" Command="{Binding AddCustomSkillCommand}" Padding="9,4" /><Button Content="移除" Command="{Binding DeleteCustomSkillCommand}" Padding="9,4" /></WrapPanel></DockPanel>
                    <ListBox x:Name="CustomSkillList" ItemsSource="{Binding SelectedGeneral.CustomSkills}" SelectedItem="{Binding SelectedCustomSkill, Mode=TwoWay}" DisplayMemberPath="Name" MinHeight="34" MaxHeight="85" Margin="0,0,0,8" />
                    <StackPanel DataContext="{Binding SelectedCustomSkill}" IsEnabled="{Binding DataContext.HasCustomSkillSelection, RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="技能名称" Style="{StaticResource Label}" /><TextBox x:Name="CustomSkillNameText" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />
                        <TextBlock Text="发动时机" Style="{StaticResource Label}" /><ComboBox x:Name="CustomTriggerCombo" ItemsSource="{Binding DataContext.TriggerChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Trigger, Mode=TwoWay}" />
                        <TextBlock Text="作用目标 · 所有效果按顺序作用于此目标" Style="{StaticResource Label}" /><ComboBox x:Name="CustomTargetCombo" ItemsSource="{Binding DataContext.TargetChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Target, Mode=TwoWay}" />
                        <TextBlock Text="发动条件" Style="{StaticResource Label}" /><ComboBox x:Name="CustomConditionCombo" ItemsSource="{Binding DataContext.ConditionChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Condition, Mode=TwoWay}" />
                        <ComboBox ItemsSource="{Binding DataContext.HpValues, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding ConditionValue, Mode=TwoWay}" Visibility="{Binding NeedsConditionValue, Converter={StaticResource Visible}}" Margin="0,5,0,0" />
                        <WrapPanel Margin="0,9,0,0"><TextBlock Text="每回合至多" VerticalAlignment="Center" Margin="0,0,7,0" /><ComboBox Width="62" ItemsSource="{Binding DataContext.AmountValues, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding UsesPerTurn, Mode=TwoWay}" /><TextBlock Text="次" VerticalAlignment="Center" Margin="7,0,14,0" /><CheckBox Content="触发时可不发动" IsChecked="{Binding Optional}" IsEnabled="{Binding IsTriggered}" /></WrapPanel>
                    </StackPanel>
                    <DockPanel Margin="0,13,0,5"><TextBlock Text="效果顺序（最多 8 条）" VerticalAlignment="Center" /><Button Content="添加效果" Command="{Binding AddEffectCommand}" HorizontalAlignment="Right" Padding="8,4" /></DockPanel>
                    <ItemsControl x:Name="CustomEffectsList" ItemsSource="{Binding SelectedCustomSkill.Effects}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#15202D" BorderBrush="#4A596B" BorderThickness="1" CornerRadius="3" Padding="7" Margin="0,4">
                        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="57" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding DataContext.EffectChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Kind, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.AmountValues, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Amount, Mode=TwoWay}" Margin="5,0,0,0" />
                            <WrapPanel Grid.Column="2"><Button Content="↑" Command="{Binding DataContext.MoveEffectUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="7,5" ToolTip="提前执行" /><Button Content="↓" Command="{Binding DataContext.MoveEffectDownCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="7,5" ToolTip="延后执行" /><Button Content="×" Command="{Binding DataContext.DeleteEffectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="7,5" ToolTip="删除此效果" /></WrapPanel>
                        </Grid><ComboBox ItemsSource="{Binding DataContext.DamageChoices, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding DamageNature, Mode=TwoWay}" Visibility="{Binding IsDamage, Converter={StaticResource Visible}}" Margin="0,6,0,0" /></StackPanel>
                    </Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel></ScrollViewer></Border>
                <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><TextBlock Text="规则预览" Style="{StaticResource Heading}" /><TextBox x:Name="CustomRulePreviewText" Grid.Row="1" Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" AutomationProperties.Name="真实规则预览" /></Grid></Border>
            </Grid>
        </Grid>
        <Border x:Name="CustomEditorErrors" Grid.Row="2" Background="#4B2425" BorderBrush="#E79482" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0" Padding="11,8" Visibility="{Binding HasErrors, Converter={StaticResource Visible}}">
            <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="请先处理以下问题" FontWeight="Bold" Foreground="#FFD9C8" /><ItemsControl ItemsSource="{Binding Errors}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#FFE3D7" Margin="0,4,0,0" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,13,0,0">
            <StackPanel><TextBlock Text="{Binding ChangeStatus}" Foreground="#D4B576" /><TextBlock Text="{Binding Status}" Foreground="#BBC8D7" Margin="0,4,0,0" MaxWidth="720" /></StackPanel>
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="重新读取" Command="{Binding ReloadCommand}" ToolTip="放弃未保存修改，重新读取本地库" /><Button x:Name="SaveCustomLibraryButton" Content="保存武将库" Command="{Binding SaveCommand}" FontWeight="Bold" Padding="18,9" /><Button Content="关闭" Click="CloseEditor" ToolTip="关闭不会保存未保存的修改" /></WrapPanel>
        </DockPanel>
    </Grid>
</Window>
