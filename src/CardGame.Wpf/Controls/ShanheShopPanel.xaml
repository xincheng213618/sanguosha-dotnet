<UserControl x:Class="CardGame.Wpf.Controls.ShanheShopPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:CardGame.Wpf.Controls" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
 <UserControl.Resources><ResourceDictionary>
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ShanheEncounterScrollStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <BooleanToVisibilityConverter x:Key="VisibleWhen"/>
  <Style x:Key="TradeButton" TargetType="Button">
   <Setter Property="Background" Value="#8C3027"/><Setter Property="Foreground" Value="#FFF1D2"/><Setter Property="BorderBrush" Value="#BA9755"/><Setter Property="Padding" Value="14,6"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="2"><Border BorderBrush="#655327" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#AA4433"/><Setter TargetName="Frame" Property="BorderBrush" Value="#F4D68E"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFEBC1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Background" Value="#514536"/><Setter TargetName="Frame" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MarketBuyButton" TargetType="Button">
   <Setter Property="Width" Value="190"/><Setter Property="Height" Value="50"/><Setter Property="Foreground" Value="#FFF1D2"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="BuyFace" Background="Transparent">
     <Image x:Name="BuyArtwork" Source="pack://siteoforigin:,,,/Assets/Wushuang/rg1v1_btn_red0.png" Stretch="Uniform" IsHitTestVisible="False"/>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,2"/>
     <Border x:Name="BuyFocus" BorderBrush="#FFF1B1" BorderThickness="1" Margin="7,4" Visibility="Collapsed" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BuyArtwork" Property="Effect"><Setter.Value><DropShadowEffect Color="#F8C959" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/></Setter.Value></Setter></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="BuyFocus" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="BuyFace" Property="Opacity" Value="0.75"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="BuyArtwork" Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="MarketProductArtworkTemplate">
   <Grid>
    <TextBlock Text="{Binding Glyph}" Foreground="#75502D" FontFamily="KaiTi" FontSize="62" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasCardImage}" Value="False"/><Condition Binding="{Binding TacticImage}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
    </TextBlock>
    <Image Source="{Binding TacticImage}" Width="230" Height="230" Stretch="Uniform" IsHitTestVisible="False"/>
    <Viewbox Width="150" Height="210" Stretch="Uniform" Visibility="{Binding HasCardImage, Converter={StaticResource VisibleWhen}}"><Grid Width="186" Height="260"><Image Source="{Binding CardImage}" Stretch="Fill"/><StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,7,0,0"><Image Source="{Binding RankArtwork}" Width="34" Height="31" Stretch="Uniform"/><Image Source="{Binding SuitArtwork}" Width="34" Height="31" Stretch="Uniform"/></StackPanel></Grid></Viewbox>
   </Grid>
  </DataTemplate>
 </ResourceDictionary></UserControl.Resources>
 <Grid x:Name="MarketSurface" ClipToBounds="True">
  <Image Source="pack://siteoforigin:,,,/Assets/shanhe-desk.png" Stretch="Fill" Opacity="0.14" IsHitTestVisible="False"/>
  <Border Background="#9A1D1A15" BorderBrush="#9F7F4A" BorderThickness="1" IsHitTestVisible="False"/>
  <Grid Margin="18,16,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid><Grid.RowDefinitions><RowDefinition Height="139"/><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
    <TextBlock Text="集&#x0a;市" FontFamily="KaiTi" Foreground="#EAC777" FontSize="49" LineHeight="59" TextAlignment="Center" Margin="0,4,6,0"><TextBlock.Effect><DropShadowEffect Color="#A58138" ShadowDepth="0" BlurRadius="12" Opacity="0.3"/></TextBlock.Effect></TextBlock>
    <ListBox Grid.Row="1" x:Name="MarketCategories" ItemsSource="{Binding ShanheMarketCategories}" SelectedItem="{Binding SelectedShanheMarketCategory}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" Padding="0">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#CBB78D"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="CategoryFrame" Background="#382B20" BorderBrush="#74603E" BorderThickness="1" Padding="8,7" Margin="0,0,14,9"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="CategoryFrame" Property="Background" Value="#CEB374"/><Setter Property="Foreground" Value="#40301E"/><Setter TargetName="CategoryFrame" Property="BorderBrush" Value="#ECD392"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CategoryFrame" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Setter Property="FontFamily" Value="KaiTi"/><Setter Property="FontSize" Value="21"/></Style></ListBox.ItemContainerStyle>
    </ListBox>
    <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,10,0"><TextBlock x:Name="MarketFreeRefreshRemaining" Text="{Binding ShanheMarketFreeRefreshRemaining}" Foreground="#BBA370" FontSize="12" TextAlignment="Center" Margin="0,0,0,3"/><TextBlock x:Name="MarketPaidRefreshRemaining" Text="{Binding ShanheMarketPaidRefreshRemaining}" Foreground="#BBA370" FontSize="12" TextAlignment="Center" Margin="0,0,0,6"/><Button x:Name="MarketRefreshButton" Content="{Binding ShanheMarketRefreshText}" Command="{Binding RefreshShanheMarketCommand}" Style="{StaticResource TradeButton}" FontSize="12" Padding="2,6" Background="#3A3023" AutomationProperties.Name="{Binding ShanheMarketRefreshText}"/></StackPanel>
   </Grid>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto" MinHeight="49"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="MarketEquipmentSummary" Text="{Binding ShanheMarketEquipmentText}" Foreground="#D9C190" FontSize="12" TextWrapping="Wrap" Margin="0,3,12,8" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Border Background="#171612" BorderBrush="#786542" BorderThickness="1" Padding="10,5"><TextBlock x:Name="MarketGold" Text="{Binding ShanheMarketGoldText}" Foreground="#E8C77D" FontSize="16"/></Border><Border Background="#171612" BorderBrush="#786542" BorderThickness="1" Padding="10,5" Margin="8,0,0,0"><TextBlock x:Name="MarketHealth" Text="{Binding ShanheMarketHealthText}" Foreground="#E4CEAD" FontSize="14" VerticalAlignment="Center"/></Border><Button x:Name="MarketCloseButton" Content="×" Command="{Binding CloseShanheMarketCommand}" Style="{StaticResource TradeButton}" FontSize="23" Padding="7,0" Margin="8,0,0,0" AutomationProperties.Name="关闭集市，返回原地图或牌桌"/></StackPanel>
     <StackPanel Grid.Row="1" Grid.ColumnSpan="2"><TextBlock Text="{Binding ShanheMarketCategoryNotice}" Foreground="#CDBB8F" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/><TextBlock Text="{Binding ShanheShopNotice}" Foreground="#9E8C6C" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" BorderBrush="#9E7B43" BorderThickness="1,2,1,2" Background="#352A2119" Padding="11,12,7,9">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="1" Text="此分类暂无货品，可切换分类或刷新集市。" Foreground="#B8A17A" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShanheMarketHasGoods}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <Button x:Name="MarketPreviousPageButton" Content="‹" Style="{StaticResource TradeButton}" Click="PreviousPage" FontSize="32" Padding="0" Height="70" VerticalAlignment="Center" AutomationProperties.Name="查看上一页货品"/>
      <ScrollViewer x:Name="MarketCardsScroll" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both" CanContentScroll="False" AutomationProperties.Name="商店货品，横向滚动查看全部">
       <ItemsControl ItemsSource="{Binding ShanheMarketGoods}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
        <Grid Width="258" VerticalAlignment="Center" Margin="0,0,18,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="60"/><RowDefinition Height="36"/></Grid.RowDefinitions>
         <Grid Width="258" Height="396.288">
          <Border x:Name="MarketProductCard" Focusable="True" KeyboardNavigation.IsTabStop="True" ToolTipService.ShowsToolTipOnKeyboardFocus="True" ToolTipService.ShowDuration="60000" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding ShopTooltip}" GotKeyboardFocus="Product_GotKeyboardFocus" LostKeyboardFocus="Product_LostKeyboardFocus" PreviewKeyDown="Product_PreviewKeyDown" Unloaded="Product_Unloaded">
           <Border.Style><Style TargetType="Border"><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#FFE38A" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/></Setter.Value></Setter></Trigger></Style.Triggers></Style></Border.Style>
           <Border.ToolTip><ToolTip ContentTemplate="{x:Null}" MaxWidth="460" Background="#F3E4C7" Foreground="#4A3727" BorderBrush="#A98A56" Padding="12" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><ToolTip.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ShanheEncounterScrollStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></ToolTip.Resources><ScrollViewer MaxHeight="480" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock Text="{Binding ShopTooltip}" TextWrapping="Wrap" FontSize="13" LineHeight="22"/></ScrollViewer></ToolTip></Border.ToolTip>
           <Grid>
            <controls:ShanheRewardChoiceCard Heading="{Binding HeadingText}" Title="{Binding DisplayName}" Description="{Binding ShopSummary}" Footer="{Binding CardStatusText}" Rarity="{Binding Rarity}" TypeIconIndex="{Binding TypeIconIndex}" ArtworkContent="{Binding}" ArtworkContentTemplate="{StaticResource MarketProductArtworkTemplate}"/>
            <Image x:Name="MarketPurchasedStamp" Source="{Binding PurchasedStampArtwork}" Width="112" Height="52" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,100,10,0" Stretch="Uniform" Visibility="{Binding ShowPurchasedStamp, Converter={StaticResource VisibleWhen}}" IsHitTestVisible="False"/>
           </Grid>
          </Border>
         </Grid>
         <Button Grid.Row="1" Style="{StaticResource MarketBuyButton}" IsEnabled="{Binding CanBuy}" Command="{Binding DataContext.RequestShanheShopPurchaseCommand, RelativeSource={RelativeSource AncestorType=controls:ShanheShopPanel}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Center" Margin="0,7,0,0">
          <StackPanel><TextBlock Text="{Binding PriceText}" FontSize="17" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="#E8D7B4" TextAlignment="Center"/></StackPanel>
         </Button>
         <TextBlock Grid.Row="2" x:Name="MarketResourceHint" Text="{Binding ResourceHint}" Foreground="#E2C18B" FontSize="12" LineHeight="16" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" VerticalAlignment="Top" Visibility="{Binding HasResourceHint, Converter={StaticResource VisibleWhen}}"/>
        </Grid>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
      <Button x:Name="MarketNextPageButton" Grid.Column="2" Content="›" Style="{StaticResource TradeButton}" Click="NextPage" FontSize="32" Padding="0" Height="70" VerticalAlignment="Center" AutomationProperties.Name="查看下一页货品"/>
     </Grid>
    </Border>
    <TextBlock Grid.Row="2" x:Name="MarketPurchaseNotice" Text="{Binding ShanheMarketSurchargeNotice}" Foreground="#B39A6F" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
