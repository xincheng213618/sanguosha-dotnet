<UserControl x:Class="CardGame.Wpf.Controls.ShanheJourneyMap"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:CardGame.Wpf.Controls"
 xmlns:campaign="clr-namespace:CardGame.Core.Campaigns;assembly=CardGame.Core"
 Width="1000" Height="{Binding ShanheMapCanvasHeight}" Background="Transparent" AutomationProperties.Name="山河图章节地理地图" KeyboardNavigation.TabNavigation="Continue">
 <UserControl.Resources>
  <DataTemplate x:Key="CityLandmark"><Grid Width="112" Height="86"><Image Source="pack://siteoforigin:,,,/Assets/shanhe-gate.png" Stretch="Uniform" VerticalAlignment="Bottom"/></Grid></DataTemplate>
  <DataTemplate x:Key="CaveLandmark"><Viewbox Width="112" Height="84"><Canvas Width="112" Height="84">
   <Ellipse Canvas.Left="3" Canvas.Top="66" Width="106" Height="14" Fill="#44574430"/>
   <Path Data="M 8,68 L 25,37 L 35,40 L 47,13 L 59,20 L 70,9 L 82,32 L 98,39 L 108,70 L 89,77 L 63,73 L 40,79 Z" Fill="#74776C" Stroke="#55594F" StrokeThickness="1.4"/>
   <Path Data="M 25,37 L 35,40 L 47,13 L 48,41 L 34,60 L 8,68 M 70,9 L 66,40 L 84,61 L 108,70 M 48,41 L 64,31 L 82,32" Fill="#9B9D8B" Stroke="#5F6559" StrokeThickness="1"/>
   <Path Data="M 42,73 Q 40,47 57,43 Q 75,47 74,73 Z" Fill="#252D27" Stroke="#B9AE87" StrokeThickness="2"/>
   <Path Data="M 49,72 Q 48,54 57,52 Q 66,54 67,72 Z" Fill="#111E1D"/>
   <Path Data="M 6,70 L 17,65 L 25,70 L 17,76 Z M 81,74 L 91,67 L 103,74 L 95,80 Z M 32,78 L 42,74 L 49,79 Z" Fill="#8D8F7F" Stroke="#565C51"/>
   <Path Data="M 15,56 L 15,39 M 8,47 L 15,39 L 23,45 M 89,38 L 89,24 M 82,32 L 89,24 L 96,30" Stroke="#52604C" StrokeThickness="3"/>
  </Canvas></Viewbox></DataTemplate>
  <DataTemplate x:Key="PlatformLandmark"><Viewbox Width="112" Height="84"><Canvas Width="112" Height="84">
   <Ellipse Canvas.Left="1" Canvas.Top="65" Width="109" Height="15" Fill="#4553442B"/>
   <Path Data="M 7,49 L 54,24 L 105,49 L 58,76 Z" Fill="#A6A58D" Stroke="#5A6359" StrokeThickness="2"/>
   <Path Data="M 7,49 L 58,76 L 58,82 L 7,57 Z M 58,76 L 105,49 L 105,57 L 58,82 Z" Fill="#777F6F" Stroke="#545F55"/>
   <Path Data="M 21,49 L 54,32 L 91,49 L 58,67 Z" Fill="#C6BB94" Stroke="#6A7160"/>
   <Path Data="M 39,45 L 55,36 L 73,45 L 56,55 Z" Fill="#858D78" Stroke="#535E51"/>
   <Path Data="M 39,45 L 39,33 L 55,24 L 73,33 L 73,45 M 55,24 L 55,37" Stroke="#6D7564" StrokeThickness="4"/>
   <Path Data="M 32,34 L 55,19 L 81,34 L 55,31 Z" Fill="#5B695D" Stroke="#424F47" StrokeThickness="1.5"/>
   <Path Data="M 87,46 L 87,8" Stroke="#615438" StrokeThickness="2"/>
   <Path Data="M 88,9 L 106,13 L 98,19 L 88,18 Z" Fill="#A04D36" Stroke="#713F2D"/>
   <Path Data="M 26,64 L 40,57 M 32,68 L 46,61 M 38,72 L 52,65" Stroke="#E4D6AE" StrokeThickness="2"/>
  </Canvas></Viewbox></DataTemplate>
  <DataTemplate x:Key="BridgeLandmark"><Viewbox Width="112" Height="84"><Canvas Width="112" Height="84">
   <Path Data="M 0,61 Q 27,42 55,59 T 112,60 M 4,69 Q 31,50 59,67 T 109,68 M 13,77 Q 39,62 69,77" Stroke="#688F86" StrokeThickness="3" Opacity="0.7"/>
   <Path Data="M 5,45 L 75,15 L 106,34 L 34,69 Z" Fill="#BBA574" Stroke="#625B44" StrokeThickness="2"/>
   <Path Data="M 5,45 L 34,69 L 34,77 L 5,53 Z M 34,69 L 106,34 L 106,42 L 34,77 Z" Fill="#777965" Stroke="#566255"/>
   <Path Data="M 14,45 L 41,64 M 25,39 L 52,59 M 37,34 L 64,53 M 49,29 L 76,47 M 62,24 L 88,41 M 75,19 L 100,36" Stroke="#6F6B4D" StrokeThickness="1.3"/>
   <Path Data="M 8,45 L 8,26 M 33,64 L 33,45 M 77,16 L 77,2 M 104,34 L 104,16 M 8,31 L 77,2 M 33,49 L 104,16" Stroke="#5C6959" StrokeThickness="3"/>
   <Path Data="M 7,52 L 7,71 M 33,76 L 33,84 M 104,42 L 104,60" Stroke="#5D6A5C" StrokeThickness="4"/>
  </Canvas></Viewbox></DataTemplate>
  <DataTemplate x:Key="LakeLandmark"><Viewbox Width="112" Height="84"><Canvas Width="112" Height="84">
   <Ellipse Canvas.Left="0" Canvas.Top="40" Width="109" Height="39" Fill="#668FA59A" Stroke="#6B8C7C"/>
   <Path Data="M 7,63 Q 34,49 57,64 T 108,64 M 16,73 Q 39,60 64,73" Stroke="#C7D1AB" StrokeThickness="2"/>
   <Path Data="M 15,43 L 55,21 L 99,43 L 57,69 Z" Fill="#B5AE8F" Stroke="#606E5F" StrokeThickness="2"/>
   <Path Data="M 15,43 L 15,53 L 57,77 L 99,53 L 99,43 M 57,69 L 57,77" Fill="#7E8976" Stroke="#596858" StrokeThickness="2"/>
   <Path Data="M 25,42 L 55,28 L 88,43 L 57,61 Z" Fill="#E0CDA5" Stroke="#68715D"/>
   <Path Data="M 43,32 L 43,18 L 58,9 L 76,20 L 76,35 Z" Fill="#A3A68C" Stroke="#566453" StrokeThickness="1.5"/>
   <Path Data="M 35,20 L 57,3 L 83,22 L 58,17 Z" Fill="#657A66" Stroke="#4F6255" StrokeThickness="1.5"/>
   <Path Data="M 55,28 L 55,44 L 65,48 L 65,33" Fill="#5B6B58"/>
   <Path Data="M 17,44 L 17,31 M 97,44 L 97,31 M 17,33 L 24,29 M 90,29 L 97,33" Stroke="#61715C" StrokeThickness="3"/>
  </Canvas></Viewbox></DataTemplate>
  <DataTemplate x:Key="ForestLandmark"><Viewbox Width="112" Height="84"><Canvas Width="112" Height="84">
   <Ellipse Canvas.Left="2" Canvas.Top="64" Width="108" Height="17" Fill="#555C6247"/>
   <Path Data="M 15,71 L 15,46 M 38,78 L 38,40 M 65,76 L 65,37 M 91,70 L 91,43" Stroke="#656746" StrokeThickness="4"/>
   <Path Data="M 0,55 L 14,30 L 29,55 L 22,54 L 32,67 L 0,67 L 8,54 Z" Fill="#7B8B67" Stroke="#5E7358"/>
   <Path Data="M 17,48 L 38,9 L 59,48 L 49,45 L 65,65 L 13,65 L 27,45 Z" Fill="#607C5C" Stroke="#4B6550" StrokeThickness="1.5"/>
   <Path Data="M 46,49 L 66,15 L 84,49 L 76,46 L 91,65 L 42,65 L 55,46 Z" Fill="#80936C" Stroke="#556D53" StrokeThickness="1.5"/>
   <Path Data="M 75,54 L 91,27 L 108,54 L 101,53 L 112,68 L 74,68 L 83,53 Z" Fill="#738863" Stroke="#526A52"/>
   <Path Data="M 27,35 L 38,15 M 57,37 L 66,21 M 86,45 L 91,32" Stroke="#B8BE91" StrokeThickness="2"/>
  </Canvas></Viewbox></DataTemplate>
  <DataTemplate x:Key="ArenaLandmark"><Viewbox Width="112" Height="84"><Canvas Width="112" Height="84">
   <Ellipse Canvas.Left="3" Canvas.Top="64" Width="106" Height="17" Fill="#555A5138"/>
   <Path Data="M 7,58 L 27,26 L 42,33 L 53,12 L 68,25 L 83,19 L 106,60 L 87,76 L 26,77 Z" Fill="#8D9480" Stroke="#5E6C59" StrokeThickness="1.5"/>
   <Path Data="M 27,26 L 39,56 L 25,76 M 53,12 L 56,52 L 87,76 M 83,19 L 74,49 L 106,60" Fill="#B4B59A" Stroke="#6A7761"/>
   <Ellipse Canvas.Left="32" Canvas.Top="53" Width="49" Height="24" Fill="#C1B887" Stroke="#E2D7A5" StrokeThickness="2"/>
   <Path Data="M 57,66 L 57,5" Stroke="#A58A4F" StrokeThickness="3"/>
   <Path Data="M 59,7 L 90,11 L 82,22 L 59,20 Z" Fill="#9F3C29" Stroke="#D3AC61" StrokeThickness="1.4"/>
   <Ellipse Canvas.Left="49" Canvas.Top="62" Width="16" Height="8" Stroke="#E8D58E" StrokeThickness="2"/>
  </Canvas></Viewbox></DataTemplate>
  <DataTemplate x:Key="NativeLandmark"><Grid>
   <Image x:Name="NativeLandmarkImage" Source="{Binding NativeArtwork}" Width="{Binding NativeLandmark.MapWidth}" Height="{Binding NativeLandmark.MapHeight}" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"/>
   <Border x:Name="NativeArenaNameplate" Width="90" Height="24" BorderBrush="#AC9A70" BorderThickness="1" Margin="-10,-18,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#DB31352E"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SceneLandmark}" Value="Arena"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter Property="Background" Value="#BF822F23"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="擂 台" Foreground="#F9E9BD" FontFamily="KaiTi" FontSize="17" TextAlignment="Center"/></Border>
  </Grid></DataTemplate>
  <Style x:Key="LandmarkArt" TargetType="ContentControl">
   <Setter Property="ContentTemplate" Value="{StaticResource CityLandmark}"/><Setter Property="Width" Value="112"/><Setter Property="Height" Value="86"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding SceneLandmark}" Value="Cave"><Setter Property="ContentTemplate" Value="{StaticResource CaveLandmark}"/></DataTrigger>
    <DataTrigger Binding="{Binding SceneLandmark}" Value="Platform"><Setter Property="ContentTemplate" Value="{StaticResource PlatformLandmark}"/></DataTrigger>
    <DataTrigger Binding="{Binding SceneLandmark}" Value="Bridge"><Setter Property="ContentTemplate" Value="{StaticResource BridgeLandmark}"/></DataTrigger>
    <DataTrigger Binding="{Binding SceneLandmark}" Value="Lake"><Setter Property="ContentTemplate" Value="{StaticResource LakeLandmark}"/></DataTrigger>
    <DataTrigger Binding="{Binding SceneLandmark}" Value="Forest"><Setter Property="ContentTemplate" Value="{StaticResource ForestLandmark}"/></DataTrigger>
    <DataTrigger Binding="{Binding SceneLandmark}" Value="Arena"><Setter Property="ContentTemplate" Value="{StaticResource ArenaLandmark}"/></DataTrigger>
    <DataTrigger Binding="{Binding HasNativeArtwork}" Value="True"><Setter Property="ContentTemplate" Value="{StaticResource NativeLandmark}"/><Setter Property="Width" Value="{Binding NativeLandmark.MapWidth}"/><Setter Property="Height" Value="{Binding NativeLandmark.MapHeight}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="JourneyNodeButton" TargetType="Button">
   <Setter Property="Width" Value="{Binding HitWidth}"/><Setter Property="Height" Value="{Binding HitHeight}"/><Setter Property="Foreground" Value="#F5E8C6"/>
   <Setter Property="Background" Value="#B63E3A2A"/><Setter Property="BorderBrush" Value="#A88D56"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid x:Name="NodeVisual" Background="Transparent" RenderTransformOrigin="0.45,0.4">
     <Image x:Name="AvailableHalo" Source="pack://siteoforigin:,,,/Assets/Shanhe/Map/rogue_city_select.png" Width="122" Height="83" Margin="-3,22,12,0" VerticalAlignment="Top" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Ellipse Width="109" Height="18" Margin="0,77,20,0" VerticalAlignment="Top" Fill="#32564E2E"/>
     <ContentControl x:Name="NodeEmblem" Content="{Binding}" Style="{StaticResource LandmarkArt}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7,0,0" IsHitTestVisible="False" Opacity="0.68"/>
     <Border x:Name="NamePlate" HorizontalAlignment="Right" VerticalAlignment="Top" Width="27" MinHeight="58" MaxHeight="128" Margin="0,6,0,0" Padding="3,6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,2,1,0">
      <TextBlock Text="{Binding VerticalName}" Foreground="{TemplateBinding Foreground}" FontFamily="KaiTi, Microsoft YaHei UI" FontSize="17" FontWeight="Bold" TextAlignment="Center" LineHeight="19"/>
     </Border>
     <Image x:Name="BattleMarker" Source="pack://siteoforigin:,,,/Assets/Shanhe/Map/rogue_event_icon3.png" Width="58" Height="58" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding BattleMarkerMargin}" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Image x:Name="EventMarker" Source="pack://siteoforigin:,,,/Assets/Shanhe/Map/rogue_event_icon2.png" Width="43" Height="52" Stretch="Uniform" Margin="{Binding EventMarkerMargin}" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Image x:Name="CampMarker" Source="pack://siteoforigin:,,,/Assets/Shanhe/Map/rogue_event_icon1.png" Width="72" Height="50" Stretch="Uniform" Margin="{Binding CampMarkerMargin}" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"/>
     <Grid x:Name="BossMarker" Width="88" Height="63" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding BossMarkerMargin}" Visibility="Collapsed" IsHitTestVisible="False">
      <Image x:Name="BossMask" Source="pack://siteoforigin:,,,/Assets/Shanhe/Map/rogue_event_icon3_2.png" Stretch="Uniform" Opacity="0.45"/>
     </Grid>
     <Border x:Name="CompletedMark" Width="21" Height="21" Background="#BA4F6244" BorderBrush="#C2C89A" BorderThickness="1" CornerRadius="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding CompletedMarkMargin}" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="✓" Foreground="#E5EAC2" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <Border x:Name="RouteFlag" BorderThickness="1" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding ExtraFlagMargin}" Visibility="Collapsed" IsHitTestVisible="False">
      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="#ED2F4640"/><Setter Property="BorderBrush" Value="#A9C3AD"/><Style.Triggers><DataTrigger Binding="{Binding RouteFlagText}" Value="主线"><Setter Property="Background" Value="#ED623B22"/><Setter Property="BorderBrush" Value="#E5BC77"/></DataTrigger><DataTrigger Binding="{Binding RouteFlagText}" Value="追击"><Setter Property="Background" Value="#ED424B2C"/><Setter Property="BorderBrush" Value="#C2CF88"/></DataTrigger></Style.Triggers></Style></Border.Style>
      <TextBlock Text="{Binding RouteFlagText}" Foreground="#FFF2CF" FontSize="12" FontWeight="SemiBold"/>
     </Border>
     <Grid x:Name="GeneralPin" Width="45" Height="59" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding PlayerPinMargin}" Visibility="Collapsed" IsHitTestVisible="False">
      <Image Source="pack://siteoforigin:,,,/Assets/Shanhe/Map/rogue_play_move_bg.png" Stretch="Uniform"/>
      <Ellipse Width="35" Height="35" Margin="0,4,0,0" VerticalAlignment="Top" Fill="{Binding DataContext.CurrentShanheGeneralPortrait, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
      <TextBlock Text="将" Foreground="#F4D899" FontFamily="KaiTi" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,7,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.HasShanheJourneyGeneralPortrait, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
     <DataTrigger Binding="{Binding IsBoss}" Value="True"><Setter TargetName="BossMarker" Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter TargetName="NodeEmblem" Property="Opacity" Value="0.75"/><Setter TargetName="CompletedMark" Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#B64C593E"/></DataTrigger>
     <DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter TargetName="NodeEmblem" Property="Opacity" Value="1"/><Setter TargetName="AvailableHalo" Property="Visibility" Value="Visible"/><Setter Property="Background" Value="#B56D4D29"/><Setter Property="BorderBrush" Value="#EDD28A"/></DataTrigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsAvailable}" Value="True"/><Condition Binding="{Binding IsBattle}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="BattleMarker" Property="Visibility" Value="Visible"/></MultiDataTrigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsAvailable}" Value="True"/><Condition Binding="{Binding Kind}" Value="{x:Static campaign:ShanheNodeKind.Event}"/></MultiDataTrigger.Conditions><Setter TargetName="EventMarker" Property="Visibility" Value="Visible"/></MultiDataTrigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsAvailable}" Value="True"/><Condition Binding="{Binding Kind}" Value="{x:Static campaign:ShanheNodeKind.Camp}"/></MultiDataTrigger.Conditions><Setter TargetName="CampMarker" Property="Visibility" Value="Visible"/></MultiDataTrigger>
     <DataTrigger Binding="{Binding HasRouteFlag}" Value="True"><Setter TargetName="RouteFlag" Property="Visibility" Value="Visible"/></DataTrigger>
     <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsAvailable}" Value="True"/><Condition Binding="{Binding IsBoss}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="BossMask" Property="Opacity" Value="1"/><Setter TargetName="BossMarker" Property="Effect"><Setter.Value><DropShadowEffect Color="#FF9F24" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/></Setter.Value></Setter></MultiDataTrigger>
     <DataTrigger Binding="{Binding IsBoss}" Value="True"><Setter TargetName="BattleMarker" Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="NodeEmblem" Property="Opacity" Value="1"/><Setter Property="Background" Value="#BC743E2A"/><Setter Property="BorderBrush" Value="#F3CE82"/></DataTrigger>
     <DataTrigger Binding="{Binding IsPlayerLocation}" Value="True"><Setter TargetName="GeneralPin" Property="Visibility" Value="Visible"/></DataTrigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsEnabled" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="NamePlate" Property="BorderBrush" Value="#FFF0C0"/><Setter TargetName="AvailableHalo" Property="Visibility" Value="Visible"/></MultiTrigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NamePlate" Property="BorderBrush" Value="#FFF2BF"/><Setter TargetName="AvailableHalo" Property="Visibility" Value="Visible"/><Setter TargetName="AvailableHalo" Property="Opacity" Value="1"/></Trigger>
     <DataTrigger Binding="{Binding HasNativeArtwork}" Value="True"><Setter TargetName="NodeVisual" Property="IsHitTestVisible" Value="False"/><Setter TargetName="NamePlate" Property="Visibility" Value="Collapsed"/><Setter TargetName="NodeEmblem" Property="Margin" Value="0"/><Setter TargetName="NodeEmblem" Property="Opacity" Value="1"/></DataTrigger>
     <DataTrigger Binding="{Binding SceneLandmark}" Value="Arena"><Setter TargetName="BattleMarker" Property="Visibility" Value="Collapsed"/></DataTrigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="NodeEmblem" Property="Opacity" Value="0.8"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Grid ClipToBounds="False">
  <Image x:Name="NativeMapBackground" Source="{Binding ShanheMapBackground}" Stretch="Fill" IsHitTestVisible="False" Visibility="{Binding HasShanheNativeMap, Converter={StaticResource BoolToVisibility}}"/>
  <Grid IsHitTestVisible="False" Opacity="0.72"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding HasShanheNativeMap}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Path Data="{Binding ShanheMapLandscapeRoads}" Stroke="#7B705333" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
   <Path Data="{Binding ShanheMapLandscapeRoads}" Stroke="#D0DCC38E" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
  </Grid>
  <ItemsControl ItemsSource="{Binding ShanheMapLinks}" IsHitTestVisible="False" Focusable="False">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate><Grid><Path Data="{Binding Route}" Stroke="#6E6E603A" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="{Binding Route}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Style><Style TargetType="Path"><Setter Property="Stroke" Value="#98E5D29D"/><Setter Property="StrokeThickness" Value="2.1"/><Style.Triggers><DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Stroke" Value="#A2A58B55"/></DataTrigger><DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter Property="Stroke" Value="#F0F0DC9C"/><Setter Property="StrokeThickness" Value="2.8"/></DataTrigger></Style.Triggers></Style></Path.Style></Path></Grid></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <ItemsControl ItemsSource="{Binding ShanheMapScenery}" IsHitTestVisible="False" Focusable="False">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
   <ItemsControl.ItemTemplate><DataTemplate><Grid Width="136" Height="132" IsHitTestVisible="False" Focusable="False">
    <Grid Opacity="0.5"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding HasNativeArtwork}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
     <Ellipse Width="109" Height="18" Margin="0,77,20,0" VerticalAlignment="Top" Fill="#32564E2E"/>
     <ContentControl Content="{Binding}" Style="{StaticResource LandmarkArt}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,7,0,0" Focusable="False"/>
    </Grid>
    <ContentControl Content="{Binding}" Style="{StaticResource LandmarkArt}" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="False" Visibility="{Binding HasNativeArtwork, Converter={StaticResource BoolToVisibility}}"/>
    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="27" MinHeight="58" MaxHeight="128" Margin="0,6,0,0" Padding="3,6" Background="#B63E3A2A" BorderBrush="#A88D56" BorderThickness="1,2,1,0"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasNativeArtwork}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
     <TextBlock Text="{Binding ShortName}" TextWrapping="Wrap" Foreground="#F5E8C6" FontFamily="KaiTi, Microsoft YaHei UI" FontSize="17" FontWeight="Bold" TextAlignment="Center" LineHeight="19"/>
    </Border>
   </Grid></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <ItemsControl ItemsSource="{Binding ShanheMapNodes}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/><Style.Triggers><DataTrigger Binding="{Binding IsPlayerLocation}" Value="True"><Setter Property="Panel.ZIndex" Value="1"/></DataTrigger><DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter Property="Panel.ZIndex" Value="2"/></DataTrigger></Style.Triggers></Style></ItemsControl.ItemContainerStyle>
   <ItemsControl.ItemTemplate><DataTemplate><controls:ShanheMapNodeButton Command="{Binding DataContext.PreviewShanheNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Node}" IsEnabled="{Binding IsAvailable}" ToolTip="{Binding DetailText}" Style="{StaticResource JourneyNodeButton}" AutomationProperties.Name="{Binding AccessibleName}"/></DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
  <Button x:Name="ShanheMapMarketButton" Width="56" Height="58" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18,212,0,0" Command="{Binding OpenShanheMarketCommand}" ToolTip="{Binding ShanheChapterMarketHint}" Visibility="{Binding IsShanheChapterMarketUnlocked, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="打开本章集市" Cursor="Hand">
   <Button.Template><ControlTemplate TargetType="Button"><Grid><Image Source="pack://siteoforigin:,,,/Assets/Shanhe/Map/rogue_shop_btn.png" Stretch="Uniform"/><Ellipse x:Name="MarketFocus" Stroke="#FFE5A1" StrokeThickness="2" Margin="3,1,3,8" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MarketFocus" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
  </Button>
 </Grid>
</UserControl>
