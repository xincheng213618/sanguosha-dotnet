<UserControl x:Class="CardGame.Wpf.Controls.ShanheJourneyMap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:campaign="clr-namespace:CardGame.Core.Campaigns;assembly=CardGame.Core"
             Width="1040" Height="600" Background="Transparent"
             AutomationProperties.Name="山河图征途路线" KeyboardNavigation.TabNavigation="Continue">
    <UserControl.Resources>
        <DataTemplate x:Key="GateEmblem"><Image Source="pack://siteoforigin:,,,/Assets/shanhe-gate.png" Width="118" Height="88" Stretch="Uniform"/></DataTemplate>
        <DataTemplate x:Key="EventEmblem"><Grid Width="88" Height="76">
            <Ellipse Width="54" Height="54" Fill="#C6C2934F" Stroke="#E9D397" StrokeThickness="2"/>
            <TextBlock Text="奇" FontFamily="KaiTi" FontSize="32" Foreground="#55472F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid></DataTemplate>
        <DataTemplate x:Key="CampEmblem"><Viewbox Width="86" Height="75"><Canvas Width="64" Height="58">
            <Path Data="M 5,51 L 31,6 L 59,51 Z" Fill="#D3A95E" Stroke="#6E5030" StrokeThickness="2"/>
            <Path Data="M 31,8 L 31,51 L 17,51 Z" Fill="#F5D99A"/>
            <Path Data="M 31,26 L 41,51 L 23,51 Z" Fill="#534132"/>
            <Path Data="M 31,6 L 31,0 M 4,52 L 60,52" Stroke="#6C5031" StrokeThickness="2"/>
            <Path Data="M 31,0 L 46,2 L 31,9 Z" Fill="#A2472F"/>
        </Canvas></Viewbox></DataTemplate>
        <DataTemplate x:Key="ShopEmblem"><Viewbox Width="88" Height="76"><Canvas Width="66" Height="60">
            <Rectangle Canvas.Left="12" Canvas.Top="25" Width="43" Height="31" Fill="#ECD09A" Stroke="#64482C" StrokeThickness="2"/>
            <Path Data="M 4,27 Q 16,23 20,11 L 47,11 Q 50,22 63,27 Z" Fill="#925039" Stroke="#5A3B28" StrokeThickness="2"/>
            <Path Data="M 11,28 L 56,28 M 8,55 L 59,55 M 22,35 L 22,50 M 44,35 L 44,50" Stroke="#6B4A2B" StrokeThickness="3"/>
            <Ellipse Canvas.Left="25" Canvas.Top="0" Width="17" Height="17" Fill="#D7AC51" Stroke="#6C4927" StrokeThickness="2"/>
            <Rectangle Canvas.Left="31" Canvas.Top="6" Width="5" Height="5" Fill="#65472A"/>
            <Rectangle Canvas.Left="29" Canvas.Top="35" Width="9" Height="20" Fill="#705331"/>
        </Canvas></Viewbox></DataTemplate>
        <Style x:Key="JourneyNodeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EFE5C7"/>
            <Setter Property="Background" Value="#D542392B"/>
            <Setter Property="BorderBrush" Value="#BBA46C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Grid Width="136" Height="132" RenderTransformOrigin="0.5,0.35" Background="Transparent">
                    <Ellipse x:Name="AvailableHalo" Width="122" Height="76" Margin="0,13,12,0" VerticalAlignment="Top" Fill="#36FFE1A1" Stroke="#E6C77C" StrokeThickness="2" Visibility="Collapsed"/>
                    <Ellipse Width="113" Height="23" VerticalAlignment="Top" Margin="0,68,18,0" Fill="#40413722"/>
                    <ContentControl x:Name="NodeEmblem" Content="{Binding}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0" IsHitTestVisible="False" Opacity="0.62">
                        <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="ContentTemplate" Value="{StaticResource GateEmblem}"/><Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static campaign:ShanheNodeKind.Event}"><Setter Property="ContentTemplate" Value="{StaticResource EventEmblem}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static campaign:ShanheNodeKind.Shop}"><Setter Property="ContentTemplate" Value="{StaticResource ShopEmblem}"/></DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static campaign:ShanheNodeKind.Camp}"><Setter Property="ContentTemplate" Value="{StaticResource CampEmblem}"/></DataTrigger>
                        </Style.Triggers></Style></ContentControl.Style>
                    </ContentControl>
                    <Border x:Name="NamePlate" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,2,0,0" Width="25" MinHeight="67" MaxHeight="130" Padding="2,7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                        <TextBlock Text="{Binding VerticalName}" Foreground="{TemplateBinding Foreground}" FontFamily="KaiTi, Microsoft YaHei UI" FontSize="17" FontWeight="Bold" TextAlignment="Center" LineHeight="21"/>
                    </Border>
                    <Viewbox x:Name="BattleMarker" Width="62" Height="61" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="29,-29,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <Viewbox.Effect><DropShadowEffect Color="#FFAE43" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/></Viewbox.Effect>
                        <Canvas Width="64" Height="64">
                            <Path Data="M 8,2 L 23,11 L 45,39 L 50,35 L 55,41 L 50,46 L 61,58 L 56,63 L 44,51 L 39,56 L 33,50 L 38,45 L 13,21 Z" Fill="#FFC17B" Stroke="#F77E35" StrokeThickness="2"/>
                            <Path Data="M 56,2 L 41,11 L 19,39 L 14,35 L 9,41 L 14,46 L 3,58 L 8,63 L 20,51 L 25,56 L 31,50 L 26,45 L 51,21 Z" Fill="#FFC17B" Stroke="#F77E35" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>
                    <Border x:Name="BossFlag" Background="#BF7F291C" BorderBrush="#F5B35D" BorderThickness="2" Width="54" Height="54" CornerRadius="27" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="33,-17,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <Border.Effect><DropShadowEffect Color="#FFAA40" BlurRadius="15" ShadowDepth="0" Opacity="0.65"/></Border.Effect>
                        <TextBlock Text="帅" Foreground="#FFE7A6" FontFamily="KaiTi" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="NodeStatus" Text="{Binding StateLabel}" Foreground="#51462E" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,92,0,0"/>
                    <Grid x:Name="GeneralPin" Width="44" Height="61" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="39,-87,0,0" Visibility="Collapsed" IsHitTestVisible="False">
                        <Path Data="M 8,33 L 36,33 L 22,60 Z" Fill="#FFE7AE" Stroke="#8E733E" StrokeThickness="1"/>
                        <Ellipse Width="44" Height="44" VerticalAlignment="Top" Stroke="#FFECB1" StrokeThickness="2.5" Fill="{Binding DataContext.CurrentShanheGeneralPortrait, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static campaign:ShanheNodeKind.BossBattle}"><Setter TargetName="BossFlag" Property="Visibility" Value="Visible"/><Setter TargetName="NodeEmblem" Property="Opacity" Value="0.9"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Background" Value="#CF4E5A3D"/><Setter Property="Foreground" Value="#E8E2C2"/><Setter TargetName="NodeStatus" Property="Foreground" Value="#455037"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="NodeEmblem" Property="Opacity" Value="1"/><Setter Property="Background" Value="#D77B3C24"/><Setter Property="BorderBrush" Value="#EEC67A"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsPlayerLocation}" Value="True"><Setter TargetName="GeneralPin" Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter TargetName="AvailableHalo" Property="Visibility" Value="Visible"/><Setter TargetName="NodeEmblem" Property="Opacity" Value="1"/><Setter Property="Background" Value="#D87E5229"/><Setter Property="BorderBrush" Value="#FFE2A1"/><Setter TargetName="NodeStatus" Property="Foreground" Value="#754326"/></DataTrigger>
                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsAvailable}" Value="True"/><Condition Binding="{Binding IsBattle}" Value="True"/></MultiDataTrigger.Conditions><Setter TargetName="BattleMarker" Property="Visibility" Value="Visible"/></MultiDataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="{x:Static campaign:ShanheNodeKind.BossBattle}"><Setter TargetName="BattleMarker" Property="Visibility" Value="Collapsed"/></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NamePlate" Property="BorderBrush" Value="#FFF1BF"/><Setter TargetName="NamePlate" Property="Background" Value="#B3753E"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="AvailableHalo" Property="Visibility" Value="Visible"/><Setter TargetName="AvailableHalo" Property="Stroke" Value="#FFFBDF"/><Setter TargetName="AvailableHalo" Property="StrokeThickness" Value="3"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="NodeEmblem" Property="Opacity" Value="0.75"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid ClipToBounds="False">
        <Image Source="pack://siteoforigin:,,,/Assets/shanhe-map.png" Stretch="Fill" IsHitTestVisible="False"/>
        <Border BorderBrush="#987548" BorderThickness="1" IsHitTestVisible="False"/>
        <ItemsControl ItemsSource="{Binding ShanheMapLinks}" IsHitTestVisible="False" Focusable="False">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate><Grid>
                <Path Data="{Binding Route}" Stroke="#A68E713F" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Path Data="{Binding Route}" StrokeStartLineCap="Round" StrokeEndLineCap="Round"><Path.Style><Style TargetType="Path">
                    <Setter Property="Stroke" Value="#DDE9D292"/><Setter Property="StrokeThickness" Value="2.5"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompleted}" Value="True"><Setter Property="Stroke" Value="#B7C89E67"/></DataTrigger>
                        <DataTrigger Binding="{Binding IsAvailable}" Value="True"><Setter Property="Stroke" Value="#FFF4CB"/><Setter Property="StrokeThickness" Value="3"/></DataTrigger>
                    </Style.Triggers>
                </Style></Path.Style></Path>
            </Grid></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl ItemsSource="{Binding ShanheMapNodes}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding X}"/><Setter Property="Canvas.Top" Value="{Binding Y}"/></Style></ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Button Command="{Binding DataContext.PreviewShanheNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Node}" IsEnabled="{Binding IsAvailable}" ToolTip="{Binding DetailText}" Style="{StaticResource JourneyNodeButton}" AutomationProperties.Name="{Binding AccessibleName}"/>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <ComboBox x:Name="ShanheSourceRegionSelector" Width="210" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0"
                  Foreground="#513D22" Background="#EAD7AE"
                  ItemsSource="{Binding ShanheSourceRegions}" SelectedItem="{Binding SelectedShanheSourceRegion, Mode=TwoWay}" DisplayMemberPath="Name"
                  ToolTip="切换查看可前往的地区，再选择其中一处前战。" AutomationProperties.Name="山河图行军地区">
            <ComboBox.Style><Style TargetType="ComboBox"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding HasShanheSourceRegionChoices}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></ComboBox.Style>
        </ComboBox>
    </Grid>
</UserControl>
