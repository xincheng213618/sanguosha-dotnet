<UserControl x:Class="CardGame.Wpf.Controls.ShanheMarketOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CardGame.Wpf.Controls"
             KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"
             FocusManager.IsFocusScope="True">
    <Grid Background="#C910100D">
        <Border Margin="24" BorderBrush="#89683E" BorderThickness="1" Background="#641B1711">
            <controls:ShanheShopPanel x:Name="MarketHost" />
        </Border>
        <controls:ShanheCampaignPanel x:Name="ReplacementHost"
            Visibility="{Binding IsShanheSkillReplacementOpen, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
