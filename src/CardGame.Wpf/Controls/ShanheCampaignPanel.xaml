<UserControl x:Class="CardGame.Wpf.Controls.ShanheCampaignPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:CardGame.Wpf.Controls" KeyboardNavigation.TabNavigation="Cycle"
 KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True"
 PreviewKeyDown="Campaign_PreviewKeyDown" FontFamily="Microsoft YaHei UI" UseLayoutRounding="True">
 <UserControl.Resources>
  <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="ShanheRewardStyles.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="CampaignButton" TargetType="Button">
   <Setter Property="Foreground" Value="#EAD7AC"/><Setter Property="Background" Value="#30271E"/>
   <Setter Property="BorderBrush" Value="#9A8153"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="17,10"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="2">
     <Border x:Name="Inset" BorderBrush="#406F5A3A" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#55402A"/><Setter TargetName="Frame" Property="BorderBrush" Value="#E0BD75"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Inset" Property="BorderBrush" Value="#FFE3A4"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="#6D351D"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CampaignButton}">
   <Setter Property="Background" Value="#872D1E"/><Setter Property="BorderBrush" Value="#D2AC62"/><Setter Property="Foreground" Value="#FFE6AC"/>
   <Setter Property="FontFamily" Value="KaiTi"/><Setter Property="FontSize" Value="25"/><Setter Property="Padding" Value="28,9"/>
  </Style>
  <Style x:Key="QuietCampaignButton" TargetType="Button" BasedOn="{StaticResource CampaignButton}">
   <Setter Property="Background" Value="#201B16"/><Setter Property="BorderBrush" Value="#665840"/><Setter Property="Padding" Value="12,6"/><Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="EncounterChallengeButton" TargetType="Button">
   <Setter Property="Foreground" Value="#FFE8AD"/><Setter Property="FontFamily" Value="KaiTi"/><Setter Property="FontSize" Value="25"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Width" Value="176"/><Setter Property="Height" Value="57"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid Background="Transparent"><controls:ShanheHudSkin x:Name="SourceButton" Source="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/red_small_btn_normal.png" Insets="30,18,30,18" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="FocusRing" BorderBrush="#FFF1B1" BorderThickness="1" Margin="8,5" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SourceButton" Property="Source" Value="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/red_small_btn_over.png"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="SourceButton" Property="Source" Value="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/red_small_btn_down.png"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="SourceButton" Property="Source" Value="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/red_small_btn_disable.png"/><Setter Property="Cursor" Value="Arrow"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="EncounterCloseButton" TargetType="Button">
   <Setter Property="Width" Value="31"/><Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTip" Value="返回章节地图"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid Background="Transparent"><Image x:Name="SourceButton" Source="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/window_close_btn2_normal.png" Stretch="Fill" IsHitTestVisible="False"/><Border x:Name="FocusRing" BorderBrush="#FFF1B1" BorderThickness="1" Margin="1" Visibility="Collapsed" IsHitTestVisible="False"/></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SourceButton" Property="Source" Value="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/window_close_btn2_over.png"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="SourceButton" Property="Source" Value="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/window_close_btn2_down.png"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="SourceButton" Property="Source" Value="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/window_close_btn2_disable.png"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="EncounterMinorEnemyButton" TargetType="Button">
   <Setter Property="Width" Value="68"/><Setter Property="Height" Value="70"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="#6A291E15" BorderBrush="#967B4E" BorderThickness="1" Padding="2"><ContentPresenter IsHitTestVisible="False"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#F5DA98"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFF0BB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="Foreground" Value="#B9AB8E"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="20"/></Style>
  <Style x:Key="SetupSelector" TargetType="ComboBox">
   <Setter Property="Foreground" Value="#EEDBB4"/><Setter Property="Background" Value="#29231C"/><Setter Property="BorderBrush" Value="#8E7651"/><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="38"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="#EBD9B8"/><Setter Property="Padding" Value="12,9"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
     <Border x:Name="Row" Background="#29231C" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
     <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#625037"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#51412D"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
   </Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#29231C" BorderBrush="#8E7651" BorderThickness="1"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" Foreground="#C7AD79" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <TextBlock Margin="12,8,34,8" Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" VerticalAlignment="Center"/>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
      <Border Background="#29231C" BorderBrush="#B79A62" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="ShanheBuildCardTemplate">
   <Border Background="#DFCEAA" BorderBrush="#A18454" BorderThickness="1" Padding="15,13" Margin="0,0,0,12" AutomationProperties.Name="{Binding AccessibleText}">
    <Border.ToolTip><ToolTip ContentTemplate="{x:Null}" MaxWidth="460"><ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding RuleTooltip}" TextWrapping="Wrap" LineHeight="22"/></ScrollViewer></ToolTip></Border.ToolTip>
    <StackPanel>
     <TextBlock Text="{Binding Name}" Foreground="#533824" FontFamily="KaiTi" FontSize="23"/>
     <TextBlock Text="{Binding Summary}" Foreground="#574731" FontSize="13" LineHeight="23" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
   </Border>
  </DataTemplate>
  <Style x:Key="CampaignTab" TargetType="TabItem">
   <Setter Property="Foreground" Value="#D5BD8C"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="TabFrame" Width="104" Height="36" Background="#D526211C" BorderBrush="#695238" BorderThickness="1" Margin="0,0,8,5" CornerRadius="3">
     <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabFrame" Property="Background" Value="#F4773024"/><Setter TargetName="TabFrame" Property="BorderBrush" Value="#E8C47D"/><Setter Property="Foreground" Value="#FFF0BB"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabFrame" Property="BorderBrush" Value="#F5DA9B"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabFrame" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="BossRewardGroupButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
   <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid Background="Transparent"><ContentPresenter/></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate x:Key="ShanheBossRewardArtworkTemplate">
   <Grid Width="{Binding Width}" Height="{Binding Height}" Margin="3" ToolTip="{Binding Name}">
    <Image x:Name="ShanheBossRewardArtwork" Source="{Binding Image}" Stretch="Uniform" Visibility="{Binding HasImage, Converter={StaticResource BoolToVisibility}}"/>
    <Border Background="#EADBB8" BorderBrush="#9A7C54" BorderThickness="2"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Glyph}" FontFamily="KaiTi" Foreground="#8C6840" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </Grid>
  </DataTemplate>
  <DataTemplate x:Key="ShanheBossRewardGalleryTemplate">
   <Grid IsHitTestVisible="False">
    <Viewbox Stretch="Uniform"><ItemsControl ItemsSource="{Binding Artworks}" ItemTemplate="{StaticResource ShanheBossRewardArtworkTemplate}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></Viewbox>
    <Image x:Name="ShanheBossCompensationArtwork" Source="{Binding DataContext.ShanheBossGoldArtwork, RelativeSource={RelativeSource AncestorType=controls:ShanheCampaignPanel}}" Width="230" Height="230" Stretch="Uniform" Visibility="{Binding IsSkipped, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="暂无" Foreground="#8C6840" FontFamily="KaiTi" FontSize="54" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsExhausted, Converter={StaticResource BoolToVisibility}}"/>
   </Grid>
  </DataTemplate>
  <Style x:Key="ReplacementUnderlay" TargetType="Border">
   <Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding IsShanheSkillReplacementOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
  </Style>
  <Style x:Key="ReplacementSkillButton" TargetType="Button">
   <Setter Property="Background" Value="#292B29"/><Setter Property="BorderBrush" Value="#74736A"/><Setter Property="Foreground" Value="#D1C9AF"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="SkillFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="10,8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SkillFrame" Property="BorderBrush" Value="#CDB172"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SkillFrame" Property="BorderBrush" Value="#FFF0BB"/></Trigger>
    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="SkillFrame" Property="BorderBrush" Value="#FFDA78"/><Setter TargetName="SkillFrame" Property="BorderThickness" Value="2"/><Setter TargetName="SkillFrame" Property="Background" Value="#5D4A2E"/><Setter Property="Foreground" Value="#FFE8AC"/></DataTrigger>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SkillFrame" Property="Opacity" Value="0.52"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid x:Name="CampaignSurface" Background="#211A14">
  <Image Source="pack://siteoforigin:,,,/Assets/shanhe-desk.png" Stretch="Fill" IsHitTestVisible="False"/>
  <Border BorderBrush="#AA8050" BorderThickness="1" Margin="6" IsHitTestVisible="False"/>
  <Grid x:Name="CampaignContent" Margin="14,8,14,10">
   <Grid.Style><Style TargetType="Grid"><Setter Property="IsEnabled" Value="True"/><Style.Triggers><DataTrigger Binding="{Binding Visibility, ElementName=ShanheSetupOverlay}" Value="Visible"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding Visibility, ElementName=ShanheRulesOverlay}" Value="Visible"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsShanheEncounterPreviewOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsShanheRestChoiceOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsShanheRewardOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsShanheBossRewardOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger><DataTrigger Binding="{Binding IsShanheSkillReplacementOpen}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style>
   <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="88"/><Style.Triggers><DataTrigger Binding="{Binding IsShanheRunInProgress}" Value="True"><Setter Property="Height" Value="0"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="#A5211B15">
     <Border Background="#8A2C20" BorderBrush="#BB874B" BorderThickness="1" Padding="8,3"><TextBlock Text="山&#x0a;河" FontFamily="KaiTi" Foreground="#F6DDA1" FontSize="19" TextAlignment="Center"/></Border>
     <StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="山河图" FontFamily="KaiTi" FontSize="28" Foreground="#F1D7A1"/><TextBlock Text="单机 · 剧情征程" Foreground="#BDA581" FontSize="10" Margin="0,3,0,0"/></StackPanel>
    </StackPanel>
    <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top" Margin="8,0">
    <Border x:Name="ShanheChapterHeader" Width="440" Height="66" BorderBrush="#A5804C" BorderThickness="1,0,1,2" CornerRadius="0,0,14,14">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#EA171A17"/><GradientStop Color="#F0352920" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid Margin="8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="ShanheChapterHeadingText" FontFamily="KaiTi" FontSize="24" Foreground="#F6D990" HorizontalAlignment="Center" MaxWidth="310" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShanheChapterTitle}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="诸 侯 伐 董"/><Style.Triggers><DataTrigger Binding="{Binding IsShanheRunInProgress}" Value="True"><Setter Property="Text" Value="{Binding ShanheChapterTitle}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock x:Name="ShanheChapterProgressText" Foreground="#D8C399" FontSize="10" HorizontalAlignment="Center" Margin="0,1,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="初平元年 · 群雄并起"/><Style.Triggers><DataTrigger Binding="{Binding IsShanheRunInProgress}" Value="True"><Setter Property="Text" Value="{Binding ShanheChapterProgressText}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <controls:ShanheChapterProgressStrip x:Name="ShanheChapterProgressMeter" Value="{Binding ShanheChapterMainProgress}" Margin="0,2,0,0"><controls:ShanheChapterProgressStrip.Style><Style TargetType="controls:ShanheChapterProgressStrip"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShanheChapterProgressTarget}" Value="6"/><Condition Binding="{Binding IsShanheRunInProgress}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></controls:ShanheChapterProgressStrip.Style></controls:ShanheChapterProgressStrip>
       </StackPanel>
       <Image x:Name="ShanheChapterBossEmblem" Grid.Column="1" Source="{Binding ShanheChapterBossArtwork}" Width="92" Height="60" Margin="6,0,0,0" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False"><Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShanheChapterProgressTarget}" Value="6"/><Condition Binding="{Binding IsShanheRunInProgress}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Image.Style></Image>
      </Grid>
    </Border>
    </Viewbox>
    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="ShanheRulesButton" Content="玩法说明" Style="{StaticResource QuietCampaignButton}" Click="ShowRules" Padding="9,9" Margin="0,0,8,0"/>
     <Button x:Name="ShanheOpenMarketButton" Content="集市" Command="{Binding OpenShanheMarketCommand}" Style="{StaticResource QuietCampaignButton}" Margin="0,0,8,0" ToolTip="{Binding ShanheChapterMarketHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="打开山河集市"/>
     <Button x:Name="ShanheCloseButton" Content="保存进度并退出" Command="{Binding CloseShanheCommand}" Style="{StaticResource QuietCampaignButton}" AutomationProperties.Name="保存征程进度并返回大厅，未完成的关卡下次重新挑战"/>
     <!-- The global end action remains available above modal choices, with its space reserved in the header. -->
     <Border Width="88" Margin="8,0,0,0" Visibility="{Binding IsShanheRunInProgress, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False"/>
    </StackPanel>
   </Grid>
   <TabControl x:Name="ShanheJourneyTabs" Grid.Row="1" TabStripPlacement="Top" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource CampaignTab}" Margin="0,3,0,0">
    <TabItem AutomationProperties.Name="山河图征途地图"><TabItem.Header><TextBlock Text="征途地图" FontFamily="KaiTi" FontSize="18"/></TabItem.Header>
     <Grid ClipToBounds="True">
      <Grid x:Name="ShanheRunRouteLayout" Visibility="{Binding IsShanheRunInProgress, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
       <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="192"/><Style.Triggers><DataTrigger Binding="{Binding HasShanheNativeMap}" Value="True"><Setter Property="Height" Value="0"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions>
       <Image Grid.RowSpan="2" Source="{Binding ShanheMapBackground}" IsHitTestVisible="False">
        <Image.Style><Style TargetType="Image"><Setter Property="Stretch" Value="Fill"/><Style.Triggers><DataTrigger Binding="{Binding HasShanheNativeMap}" Value="True"><Setter Property="Stretch" Value="UniformToFill"/><Setter Property="Opacity" Value="0.45"/><Setter Property="Effect"><Setter.Value><BlurEffect Radius="20"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></Image.Style>
       </Image>
       <ScrollViewer x:Name="ShanheMapScroll" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
        <ScrollViewer.Style><Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Disabled"/><Style.Triggers><DataTrigger Binding="{Binding IsShanheMapScrollable}" Value="True"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></DataTrigger></Style.Triggers></Style></ScrollViewer.Style>
        <!-- Fit the whole interactive coordinate plane; filling a wide viewport crops usable destinations. -->
        <Viewbox VerticalAlignment="Center" Stretch="Uniform"><controls:ShanheJourneyMap x:Name="ShanheMapRows"/></Viewbox>
       </ScrollViewer>
       <StackPanel x:Name="ShanheMapToolbar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="18,10,18,0">
        <Button x:Name="ShanheResumeBattleButton" Content="{Binding ShanheBattleActionText}" Command="{Binding ResumeShanheBattleCommand}" Style="{StaticResource PrimaryButton}" Width="140" Height="36" FontSize="16" Padding="12,4" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding IsShanheBattleActive, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding ShanheBattleActionText}"/>
        <ComboBox x:Name="ShanheSourceRegionSelector" Width="190" Height="32" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#513D22" Background="#EAD7AE" ItemsSource="{Binding ShanheSourceRegions}" SelectedItem="{Binding SelectedShanheSourceRegion, Mode=TwoWay}" DisplayMemberPath="Name" ToolTip="切换查看本章地区" AutomationProperties.Name="山河图行军地区" Visibility="{Binding HasShanheSourceRegionChoices, Converter={StaticResource BoolToVisibility}}"/>
        <Border x:Name="ShanheMapGoldCounter" Height="36" MinWidth="140" MaxWidth="216" Background="#D52B2114" BorderBrush="#A1804C" BorderThickness="1" CornerRadius="18" Padding="8,3,10,3" IsHitTestVisible="False" AutomationProperties.Name="{Binding ShanheGoldText}">
         <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/14021801.png" Width="28" Height="28" Stretch="Uniform" Margin="0,0,8,0"/><Viewbox MaxWidth="150" Stretch="Uniform" StretchDirection="DownOnly"><TextBlock x:Name="ShanheMapGoldValue" Text="{Binding ShanheGoldText}" Foreground="#F4D69A" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></Viewbox></StackPanel>
        </Border>
       </StackPanel>
       <controls:ShanheJourneyLoadout x:Name="ShanhePlayerHudHost" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="8,0,8,0"><controls:ShanheJourneyLoadout.Style><Style TargetType="controls:ShanheJourneyLoadout"><Setter Property="Grid.Row" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding HasShanheNativeMap}" Value="True"><Setter Property="Grid.Row" Value="0"/></DataTrigger></Style.Triggers></Style></controls:ShanheJourneyLoadout.Style></controls:ShanheJourneyLoadout>
      </Grid>
      <Grid x:Name="ShanhePreparationPage" Visibility="{Binding IsShanhePreparation, Converter={StaticResource BoolToVisibility}}">
       <Image Source="pack://siteoforigin:,,,/Assets/shanhe-map.png" Stretch="UniformToFill" IsHitTestVisible="False"/>
       <Border Background="#B8EFDFBC" BorderBrush="#9F7C4F" BorderThickness="1" Margin="18,17"/>
       <Grid Margin="53,43,43,38"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="235"/></Grid.ColumnDefinitions>
        <Grid Margin="0,0,28,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <StackPanel><TextBlock Text="出 征 准 备" FontFamily="KaiTi" FontSize="45" Foreground="#58391E"/><TextBlock Text="{Binding SelectedShanheScenario.Name}" FontFamily="KaiTi" FontSize="24" Foreground="#80603B" Margin="0,13,0,0"/><Border Background="#885C3E23" Height="1" Margin="0,18,0,0"/></StackPanel>
