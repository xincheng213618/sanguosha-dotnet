         <controls:ShanheRewardChoiceCard MaxWidth="300" Heading="{Binding Name}" Title="{Binding OverviewTitle}" Description="{Binding OverviewDescription}" Footer="{Binding OverviewFooter}" Rarity="{Binding Rarity}" TypeIconIndex="{Binding TypeIconIndex}" ArtworkContent="{Binding}" ArtworkContentTemplate="{StaticResource ShanheBossRewardGalleryTemplate}"/>
        </Button>
       </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Border x:Name="ShanheBossFixedSkillSlotsCard" Grid.Column="2" Margin="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasShanheBossFixedRewards, Converter={StaticResource BoolToVisibility}}">
        <controls:ShanheRewardChoiceCard MaxWidth="240" Heading="技能槽" Title="{Binding ShanheBossSkillSlotsText}" Description="本次征程持续生效" Footer="已生效" Artwork="{Binding ShanheBossSkillSlotsArtwork}" Rarity="2" TypeIconIndex="3"/>
       </Border>
      </Grid>
      <Button x:Name="ShanheConfirmBossRewardButton" Grid.Row="2" Content="{Binding ShanheBossRewardContinueText}" Command="{Binding ConfirmShanheBossRewardCommand}" Style="{StaticResource EncounterChallengeButton}" Width="240" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding ShanheBossRewardContinueText}"/>
     </Grid>
    </Border>
    <Border x:Name="ShanheSkillReplacementOverlay" Background="#A8000000" Visibility="{Binding IsShanheSkillReplacementOpen, Converter={StaticResource BoolToVisibility}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained" FocusManager.IsFocusScope="True">
     <Border Width="930" Height="535" BorderBrush="#A09B89" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1"><GradientStop Color="#494B47"/><GradientStop Color="#292B29" Offset="0.48"/><GradientStop Color="#343632" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid>
       <Image Source="pack://siteoforigin:,,,/Assets/shanhe-desk.png" Stretch="Fill" Opacity="0.06" IsHitTestVisible="False"/>
       <Border BorderBrush="#59726F60" BorderThickness="1" Margin="6" IsHitTestVisible="False"/>
       <Grid Margin="32,23,32,22"><Grid.RowDefinitions><RowDefinition Height="51"/><RowDefinition Height="79"/><RowDefinition Height="39"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
        <TextBlock Text="替 换 技 能" Foreground="#E5DDC4" FontFamily="KaiTi" FontSize="32" TextAlignment="Center" VerticalAlignment="Center"/>
        <Border Grid.Row="1" BorderBrush="#E5C574" BorderThickness="2" Background="#4A4535" Padding="22,11" MinWidth="230" MaxWidth="650" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding ShanheReplacementIncomingName}" Foreground="#F6D887" FontFamily="KaiTi" FontSize="29" TextWrapping="Wrap" TextAlignment="Center"/></Border>
        <TextBlock Grid.Row="2" Text="技能槽已满，请选择一项额外技能替换。自带技能不可替换。" Foreground="#C4BCA7" FontSize="14" TextAlignment="Center" VerticalAlignment="Center"/>
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
         <ItemsControl x:Name="ShanheSkillReplacementRows" ItemsSource="{Binding ShanheSkillReplacementOptions}" HorizontalAlignment="Center"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
          <Button Width="196" Height="73" Margin="6" Style="{StaticResource ReplacementSkillButton}" IsEnabled="{Binding IsEnabled}" Command="{Binding DataContext.SelectShanheSkillReplacementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
           <Button.ToolTip><ToolTip ContentTemplate="{x:Null}"><TextBlock Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="360"/></ToolTip></Button.ToolTip>
           <StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="{Binding Name}" FontFamily="KaiTi" FontSize="25" TextTrimming="CharacterEllipsis" MaxWidth="157"/></StackPanel><TextBlock FontSize="10" TextAlignment="Center" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="可替换"/><Setter Property="Foreground" Value="#A99F87"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Text" Value="已选择"/><Setter Property="Foreground" Value="#E2C783"/></DataTrigger><DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="Text" Value="自带 · 不可替换"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
          </Button>
         </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button x:Name="ShanheConfirmSkillReplacementButton" Content="确 定" Command="{Binding ConfirmShanheSkillReplacementCommand}" Style="{StaticResource PrimaryButton}" MinWidth="150" FontSize="24" Padding="20,8"/><Button x:Name="ShanheCancelSkillReplacementButton" Content="取 消" Command="{Binding CancelShanheSkillReplacementCommand}" Style="{StaticResource CampaignButton}" MinWidth="130" FontFamily="KaiTi" FontSize="23" Background="#333630" Padding="20,8" Margin="22,0,0,0"/></StackPanel>
       </Grid>
       <Button x:Name="ShanheSkillReplacementCloseButton" Content="×" Command="{Binding CancelShanheSkillReplacementCommand}" Style="{StaticResource QuietCampaignButton}" FontSize="24" Padding="6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,11,0" Background="#292B27" AutomationProperties.Name="取消技能替换并返回"/>
      </Grid>
     </Border>
    </Border>
    <controls:ShanheSettlementPanel x:Name="ShanheSettlementHost" Grid.RowSpan="3" Visibility="{Binding IsShanheSettlementOpen, Converter={StaticResource BoolToVisibility}}"/>
    <Grid Height="70" Margin="14,8,14,0" VerticalAlignment="Top" Panel.ZIndex="10">
     <Button x:Name="ShanheEndButton" Content="结束征程" Command="{Binding EndShanheCommand}" Style="{StaticResource QuietCampaignButton}" Width="88" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsShanheRunInProgress, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="结束本次征程并返回出征准备"/>
    </Grid>
    <Border x:Name="ShanheEndConfirmation" Background="#E5100D0A" Panel.ZIndex="20" Visibility="{Binding IsShanheEndConfirmationOpen, Converter={StaticResource BoolToVisibility}}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" FocusManager.IsFocusScope="True">
     <Border MaxWidth="520" Margin="24" Padding="28" Background="#30271E" BorderBrush="#BD9458" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel>
       <TextBlock Text="结束本次征程？" FontFamily="KaiTi" FontSize="30" Foreground="#FFE0A0"/>
       <TextBlock Text="结束后返回出征准备，可重新选将、配置山河册。本次征程将记录为未通关，无法继续；已获得的图册和收藏保留。" Foreground="#DFCDA8" TextWrapping="Wrap" LineHeight="25" Margin="0,18,0,0"/>
       <TextBlock Text="若只是暂时离开，请取消后使用「保存进度并退出」；本关下次重新挑战，之前的征程进度保留。" Foreground="#BBA98A" TextWrapping="Wrap" LineHeight="23" Margin="0,12,0,0"/>
       <TextBlock Text="{Binding ShanheEndError}" Foreground="#FFB19C" TextWrapping="Wrap" Margin="0,12,0,0"/>
       <WrapPanel HorizontalAlignment="Right" Margin="0,22,0,0">
        <Button x:Name="ShanheCancelEndButton" Content="取消，继续征程" Command="{Binding CancelEndShanheCommand}" Style="{StaticResource CampaignButton}" Margin="0,0,12,0"/>
        <Button x:Name="ShanheConfirmEndButton" Content="确认结束" Command="{Binding ConfirmEndShanheCommand}" Style="{StaticResource CampaignButton}" Background="#872D1E"/>
       </WrapPanel>
      </StackPanel>
     </Border>
    </Border>
 </Grid>
</UserControl>
