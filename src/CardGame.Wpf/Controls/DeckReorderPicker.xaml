<UserControl x:Class="CardGame.Wpf.Controls.DeckReorderPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="DeckBoolToVisibility" />
        <DataTemplate x:Key="OrderFace">
            <Grid Margin="4,3" Cursor="Hand" PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" PreviewMouseMove="Card_PreviewMouseMove" LostMouseCapture="Card_LostMouseCapture">
                <Border x:Name="OrderCardFace" Width="78" Height="109" BorderBrush="#C5A366" BorderThickness="1" CornerRadius="3" Background="#E6D5AE">
                    <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CardFaceTemplate}" IsHitTestVisible="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Grid Background="Transparent" AllowDrop="True" PreviewDragOver="Picker_PreviewDragOver" PreviewMouseLeftButtonUp="Picker_PreviewMouseLeftButtonUp">
        <StackPanel>
            <TextBlock Text="{Binding DeckTopLabel}" Foreground="#F2D28A" HorizontalAlignment="Center" Margin="0,0,0,3" Visibility="{Binding HasDeckTopRow, Converter={StaticResource DeckBoolToVisibility}}" />
            <Border x:Name="DeckTopRow" Background="#50312419" BorderBrush="#A78E5D" BorderThickness="1" CornerRadius="4" MinHeight="146" DragOver="Row_DragOver" Drop="Row_Drop" Visibility="{Binding HasDeckTopRow, Converter={StaticResource DeckBoolToVisibility}}">
                <ItemsControl x:Name="DeckTopItems" ItemsSource="{Binding DeckTopCards}" ItemTemplate="{StaticResource OrderFace}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
            <TextBlock Text="{Binding DeckBottomLabel}" Foreground="#F2D28A" HorizontalAlignment="Center" Margin="0,8,0,3" />
            <Border x:Name="DeckBottomRow" Background="#50312419" BorderBrush="#A78E5D" BorderThickness="1" CornerRadius="4" MinHeight="146" DragOver="Row_DragOver" Drop="Row_Drop">
                <ItemsControl x:Name="DeckBottomItems" ItemsSource="{Binding DeckBottomCards}" ItemTemplate="{StaticResource OrderFace}" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </StackPanel>
        <Canvas x:Name="DragOverlay" IsHitTestVisible="False" />
    </Grid>
</UserControl>
