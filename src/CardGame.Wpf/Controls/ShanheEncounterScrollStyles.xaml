<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <BitmapImage x:Key="EncounterArrowUp" UriSource="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/rogue_arrow_up.png"/>
 <BitmapImage x:Key="EncounterArrowDown" UriSource="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/rogue_arrow_down.png"/>
 <BitmapImage x:Key="EncounterArrowLeft" UriSource="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/rogue_arrow_left.png"/>
 <BitmapImage x:Key="EncounterArrowRight" UriSource="pack://siteoforigin:,,,/Assets/Shanhe/Encounter/rogue_arrow_right.png"/>
 <Style x:Key="EncounterScrollPage" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="EncounterScrollArrow" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/><Setter Property="Opacity" Value="0.8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Image Source="{TemplateBinding Tag}" Stretch="Uniform" Margin="1" IsHitTestVisible="False"/></Grid></ControlTemplate></Setter.Value></Setter>
  <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></Style.Triggers>
 </Style>
 <Style x:Key="EncounterScrollThumb" TargetType="Thumb">
  <Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="#987D4D"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border x:Name="Grip" Margin="2" Background="{TemplateBinding Background}" BorderBrush="#C2A46A" BorderThickness="1" CornerRadius="3"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#C7AA6B"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#E1C284"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <ControlTemplate x:Key="EncounterVerticalScroll" TargetType="ScrollBar">
  <Grid Background="Transparent"><Grid.RowDefinitions><RowDefinition Height="14"/><RowDefinition Height="*"/><RowDefinition Height="14"/></Grid.RowDefinitions>
   <RepeatButton Grid.Row="0" Style="{StaticResource EncounterScrollArrow}" Command="{x:Static ScrollBar.LineUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Tag="{StaticResource EncounterArrowUp}" AutomationProperties.Name="向上滚动"/>
   <Border Grid.Row="1" Width="2" Background="#7050442F" HorizontalAlignment="Center"/>
   <Track x:Name="PART_Track" Grid.Row="1" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource EncounterScrollPage}"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Style="{StaticResource EncounterScrollThumb}" MinHeight="24"/></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource EncounterScrollPage}"/></Track.IncreaseRepeatButton>
   </Track>
   <RepeatButton Grid.Row="2" Style="{StaticResource EncounterScrollArrow}" Command="{x:Static ScrollBar.LineDownCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Tag="{StaticResource EncounterArrowDown}" AutomationProperties.Name="向下滚动"/>
  </Grid>
 </ControlTemplate>
 <ControlTemplate x:Key="EncounterHorizontalScroll" TargetType="ScrollBar">
  <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/></Grid.ColumnDefinitions>
   <RepeatButton Grid.Column="0" Style="{StaticResource EncounterScrollArrow}" Command="{x:Static ScrollBar.LineLeftCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Tag="{StaticResource EncounterArrowLeft}" AutomationProperties.Name="向左滚动"/>
   <Border Grid.Column="1" Height="2" Background="#7050442F" VerticalAlignment="Center"/>
   <Track x:Name="PART_Track" Grid.Column="1" Orientation="Horizontal" IsDirectionReversed="False" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageLeftCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource EncounterScrollPage}"/></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Style="{StaticResource EncounterScrollThumb}" MinWidth="24"/></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageRightCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource EncounterScrollPage}"/></Track.IncreaseRepeatButton>
   </Track>
   <RepeatButton Grid.Column="2" Style="{StaticResource EncounterScrollArrow}" Command="{x:Static ScrollBar.LineRightCommand}" CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" Tag="{StaticResource EncounterArrowRight}" AutomationProperties.Name="向右滚动"/>
  </Grid>
 </ControlTemplate>
 <Style TargetType="ScrollBar">
  <Setter Property="Focusable" Value="False"/><Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="0"/><Setter Property="Width" Value="14"/><Setter Property="Template" Value="{StaticResource EncounterVerticalScroll}"/>
  <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/><Setter Property="Template" Value="{StaticResource EncounterHorizontalScroll}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger></Style.Triggers>
 </Style>
</ResourceDictionary>
