<UserControl x:Class="CardGame.Wpf.Controls.PrivateCardExchangePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ExchangeBoolToVisibility" />
        <DataTemplate x:Key="ExchangeFace">
            <Button Margin="4,3" Command="{Binding DataContext.SelectCardExchangeCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}" Style="{DynamicResource BareButton}" ToolTip="{Binding Name}">
                <Border Width="78" Height="109" CornerRadius="3" Background="#E6D5AE">
                    <Border.Style><Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="#A78E5D" /><Setter Property="BorderThickness" Value="1" />
                        <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BorderBrush" Value="#FFF0A5" /><Setter Property="BorderThickness" Value="3" />
                        </DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                    <ContentControl Content="{Binding}" ContentTemplate="{DynamicResource CardFaceTemplate}" IsHitTestVisible="False"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
                </Border>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Visibility="{Binding IsCardExchangeViewPending, Converter={StaticResource ExchangeBoolToVisibility}}">
            <TextBlock Text="{Binding ExchangeTopLabel}" Foreground="#F2D28A" HorizontalAlignment="Center" Margin="0,0,0,3" />
            <Border Background="#50312419" BorderBrush="#A78E5D" BorderThickness="1" CornerRadius="4" MinHeight="118">
                <ItemsControl x:Name="ExchangeDeckCards" ItemsSource="{Binding ExchangeTopCards}" ItemTemplate="{StaticResource ExchangeFace}" HorizontalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </StackPanel>
        <TextBlock Text="{Binding ExchangeHandLabel}" Foreground="#F2D28A" HorizontalAlignment="Center" Margin="0,8,0,3" />
        <Border Background="#50312419" BorderBrush="#A78E5D" BorderThickness="1" CornerRadius="4" MinHeight="118">
            <ItemsControl x:Name="ExchangeTargetHand" ItemsSource="{Binding ExchangeHandCards}" ItemTemplate="{StaticResource ExchangeFace}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
