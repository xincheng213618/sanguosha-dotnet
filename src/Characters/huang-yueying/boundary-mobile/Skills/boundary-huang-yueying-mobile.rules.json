{
  "schemaVersion": 62,
  "skills": [
    {
      "id": "boundary:jizhi-mobile",
      "revision": 1,
      "triggers": [
        {
          "id": "ordinary-trick-used",
          "window": "cardUseTargetsFinalized",
          "ownerRelation": "actor",
          "cardCategories": ["instantTrick"],
          "optional": true,
          "effects": [
            { "op": "draw", "target": "owner", "amount": 1, "resultBind": "drawn" },
            { "op": "chooseOption", "target": "owner", "resultBind": "draw-disposition", "options": [
              { "id": "keep", "condition": { "kind": "always" } },
              { "id": "discard", "condition": { "kind": "all", "children": [
                { "kind": "boundCardsMatchCategories", "sourceBind": "drawn", "cardCategories": ["basic"] },
                { "kind": "boundCardCountAtLeast", "sourceBind": "drawn", "value": 1 }
              ] } }
            ] },
            { "op": "moveBoundCards", "target": "owner", "sourceBind": "drawn", "destination": "discardPile",
              "condition": { "kind": "choiceIs", "sourceBind": "draw-disposition", "optionId": "discard" } },
            { "op": "grantTurnRuleModifier", "target": "owner", "ruleQuery": "handLimit", "ruleOperation": "add", "amount": 1,
              "condition": { "kind": "choiceIs", "sourceBind": "draw-disposition", "optionId": "discard" } }
          ]
        },
        {
          "id": "nullification-used",
          "window": "cardResponseAccepted",
          "ownerRelation": "actor",
          "cardKinds": ["nullification"],
          "optional": true,
          "effects": [
            { "op": "draw", "target": "owner", "amount": 1, "resultBind": "drawn" },
            { "op": "chooseOption", "target": "owner", "resultBind": "draw-disposition", "options": [
              { "id": "keep", "condition": { "kind": "always" } },
              { "id": "discard", "condition": { "kind": "all", "children": [
                { "kind": "boundCardsMatchCategories", "sourceBind": "drawn", "cardCategories": ["basic"] },
                { "kind": "boundCardCountAtLeast", "sourceBind": "drawn", "value": 1 }
              ] } }
            ] },
            { "op": "moveBoundCards", "target": "owner", "sourceBind": "drawn", "destination": "discardPile",
              "condition": { "kind": "choiceIs", "sourceBind": "draw-disposition", "optionId": "discard" } },
            { "op": "grantTurnRuleModifier", "target": "owner", "ruleQuery": "handLimit", "ruleOperation": "add", "amount": 1,
              "condition": { "kind": "choiceIs", "sourceBind": "draw-disposition", "optionId": "discard" } }
          ]
        }
      ]
    }
  ]
}
