      "modifiers": [{ "id": "hand-limit-penalty", "query": "handLimit", "operation": "add", "value": -3, "priority": 0 }]
    },
    {
      "id": "mobile:yijin-yongbi", "revision": 1,
      "triggers": [{
        "id": "skip-draw", "window": "turnStartBeforeNormalFlow", "subject": "owner", "optional": false,
        "effects": [{ "op": "skipTurnPhases", "target": "owner", "phases": ["draw"] }]
      }]
    }
  ]
