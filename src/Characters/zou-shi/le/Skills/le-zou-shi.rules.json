{
  "schemaVersion": 64,
  "skills": [
    {
      "id": "le:yunzheng",
      "revision": 1,
      "skillStates": [{
        "action": "suppress", "target": "all",
        "match": { "filter": ["==", ["number", "skill.locked"], 0] },
        "while": ["and", ["not", ["same", "owner", "target"]], [">", ["cardMarkCount", "target", "zheng", "hand"], 0]]
      }],
      "triggers": [
        {
          "id": "mark-initial-entities",
          "window": "gameStarting",
          "subject": "owner",
          "optional": false,
          "effects": [{ "op": "markInitialHand", "target": "owner", "mark": "zheng" }]
        }
      ]
    },
    {
      "id": "le:huoxin",
      "revision": 1,
      "triggers": [
        {
          "id": "non-equipment-use",
          "window": "cardUseCommitted",
          "ownerRelation": "actor",
          "optional": true,
          "includeResponseUses": true,
          "allowNoEventTarget": true,
          "singleActionInstance": true,
          "usageScope": "event", "usageLimit": 1,
          "effects": [{ "op": "resolveHuoxinNonEquipmentUse", "target": "owner" }]
        }
      ]
    }
  ]
}
