{
  "schemaVersion": 62,
  "skills": [{ "id": "boundary:jianchu-mobile", "revision": 1,
    "triggers": [{ "id": "discard-final-target-card", "window": "cardUseTargetsFinalized", "ownerRelation": "actor", "cardKinds": ["slash", "fireSlash", "thunderSlash"], "optional": true,
      "effects": [
        { "op": "selectAndMoveOwnedCard", "target": "owner", "chooserRef": { "kind": "owner" }, "cardOwnerRef": { "kind": "eventTarget" },
          "zones": ["hand", "equipment"], "count": 1, "destination": "discardPile", "resultBind": "discarded-target-card", "awaitMovementTriggers": true },
        { "op": "claimCurrentUsePhysicalCards", "target": "owner", "condition": { "kind": "boundCardsMatchCategories", "sourceBind": "discarded-target-card", "cardCategories": ["basic", "trick"] } },
        { "op": "preventCurrentTargetSlashCancellationByRule", "target": "owner", "condition": { "kind": "boundCardsMatchCategories", "sourceBind": "discarded-target-card", "cardCategories": ["equipment"] } }
      ] }]
  }]
}
