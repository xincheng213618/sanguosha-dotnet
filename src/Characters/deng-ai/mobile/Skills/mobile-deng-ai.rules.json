            {
              "op": "moveBoundCards", "target": "owner", "sourceBind": "tuntian-card", "destination": "ownerPersistentZone", "destinationZone": "authority", "awaitMovementTriggers": true,
              "condition": { "kind": "judgmentOutcomeMatchesSuits", "sourceBind": "tuntian-outcome", "suits": ["spade", "club", "diamond", "none"] }
